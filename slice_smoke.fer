fn assert_i32(label: str, got: i32, want: i32) -> void {
    if got != want {
        panic label
    }
}

fn sum3(items: []i32) -> i32 {
    return items[0] + items[1] + items[2]
}

fn set_first(items: []mut i32, value: i32) -> void {
    items[0] = value
}

fn set_second(items: []mut i32, value: i32) -> void {
    items[1] = value
}

fn main() -> void {
    let mut items: [3]i32 = [3]i32{1, 2, 3}

    assert_i32("array to readonly slice call failed", sum3(items), 6)

    let readonly: []i32 = items
    assert_i32("readonly slice binding failed", sum3(readonly), 6)

    set_first(items, 9)
    assert_i32("mutable slice call did not update array", items[0], 9)

    let writable: []mut i32 = items
    set_second(writable, 7)
    assert_i32("mutable slice binding did not update array", items[1], 7)
    assert_i32("mutable slice to readonly coercion failed", sum3(writable), 19)

    print("slice smoke test: PASS")
}
