import "std/io"
import "std/net/tcp"

fn main() -> void {
    let mut conn = tcp::Dial("127.0.0.1", 9101) catch |err| {
        print(err)
        return
    }
    _ = io::Write(conn, "ping") catch |err| {
        print(err)
        conn.Close()
        return
    }
    let data = io::Read(conn, 4) catch |err| {
        print(err)
        conn.Close()
        return
    }
    if len(data) == 4 && data as str == "ping" {
        print("tcp-client-ok")
        conn.Close()
        return
    }
    print("tcp-client-fail")
    conn.Close()
}
