fn main() -> void {
    let mut nums = map[str]i32{"one" => 1}
    println(size(&nums) as str)
    println((get(&nums, "one") ?? 0) as str)
    println((set(&mut nums, "one", 2) ?? 0) as str)
    println((get(&nums, "one") ?? 0) as str)
    println("capacity: ", cap(&nums))

    let mut words = map[str]str{"a" => "alpha"}
    println(size(&words) as str)
    if get(&words, "a") is str {
        println("true")
    } else {
        println("false")
    }
    if set(&mut words, "a", "beta") is str {
        println("true")
    } else {
        println("false")
    }
    if get(&words, "a") is str {
        println("true")
    } else {
        println("false")
    }
    if get(&words, "missing") is str {
        println("true")
    } else {
        println("false")
    }
}
