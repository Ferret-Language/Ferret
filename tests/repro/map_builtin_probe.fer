fn main() -> void {
    let mut nums = map[str]i32{"one" => 1}
    println(to_str(size(&nums)))
    println(to_str(get(&nums, "one") ?? 0))
    println(to_str(set(&mut nums, "one", 2) ?? 0))
    println(to_str(get(&nums, "one") ?? 0))
    println("capacity: ", cap(&nums))

    let mut words = map[str]str{"a" => "alpha"}
    println(to_str(size(&words)))
    if get(&words, "a") is str {
        println("true")
    } else {
        println("false")
    }
    if set(&mut words, "a", "beta") is str {
        println("true")
    } else {
        println("false")
    }
    if get(&words, "a") is str {
        println("true")
    } else {
        println("false")
    }
    if get(&words, "missing") is str {
        println("true")
    } else {
        println("false")
    }
}
