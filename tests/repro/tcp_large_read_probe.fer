import "std/io"
import "std/net/tcp"

fn main() -> void {
    let mut conn = tcp::Dial("127.0.0.1", 9104) catch |err| {
        print(err)
        return
    }

    let a = io::Read(conn, 4096) catch |err| {
        print(err)
        conn.Close()
        return
    }
    let b = io::Read(conn, 4096) catch |err| {
        print(err)
        conn.Close()
        return
    }
    let c = io::Read(conn, 4096) catch |err| {
        print(err)
        conn.Close()
        return
    }
    let d = io::Read(conn, 1) catch |err| {
        print(err)
        conn.Close()
        return
    }

    if len(a) == 4096 && len(b) == 4096 && len(c) == 808 && len(d) == 0 {
        print("tcp-large-read-ok")
        conn.Close()
        return
    }

    print("tcp-large-read-fail")
    conn.Close()
}
