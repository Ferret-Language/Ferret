type Point struct {
    x: i32,
    y: i32
}

fn Point::Area(self) -> i32 {
    return self.x + self.y
}

type Circle struct {
    rad: i32
}

fn Circle::Area(self) -> i32 {
    return self.rad
}

type Rectangle struct {
    height: i32,
    width: i32
}

fn Rectangle::Area(self) -> i32 {
    return self.height + self.width
}

type Shape interface {
    Area(self) -> i32
}

fn printArea(shapes: ...Shape) -> void {
    for shapes |s| {
        println(s.Area())
    }
}

fn main() -> void {
    let p = .Point{ .x = 1, .y = 2 }
    let c = .Circle{ .rad = 3 }
    let r = .Rectangle{ .height = 13, .width = 34 }
    printArea(p, c, r)
}
