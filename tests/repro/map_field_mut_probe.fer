type Holder struct {
    routes: map[str]i32
}

fn Holder::Add(&mut self, key: str, value: i32) -> void {
    _ = set(&mut self.routes, key, value)
}

fn main() -> void {
    let mut holder: Holder = .{ .routes = {} }
    holder.Add("x", 1)
    println("size=", size(&holder.routes) as str)
    if get(&holder.routes, "x") is i32 {
        println("found")
    } else {
        println("missing")
    }
}
