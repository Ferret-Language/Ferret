type Io error {
    denied
}

fn load(ok: bool) -> Io!i32 {
    if ok {
        return 41
    }
    return Io::denied
}

fn with_fallback(ok: bool) -> i32 {
    return load(ok) catch -1
}

fn with_handler(ok: bool) -> i32 {
    let resolved = load(ok) catch |err| {
        let code: Io = err
        if code == Io::denied {
            return 7
        }
        return 0
    }
    return resolved + 1
}

fn main() -> void {
    let a = with_fallback(true)
    let b = with_fallback(false)
    let c = with_handler(true)
    let d = with_handler(false)

    if a == 41 && b == -1 && c == 42 && d == 7 {
        print("error-union-ready-ok")
        return
    }

    print("error-union-ready-fail")
    exit(1)
}
