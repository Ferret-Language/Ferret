import "std/string"

fn greet(prefix: str, name: str) -> string::String {
    let mut out = string::FromStr(prefix)
    out.PushStr(name)
    out.PushStr("!")
    return out
}

fn append_label(mut text: string::String, label: str) -> string::String {
    text.PushStr(label)
    return text
}

fn main() -> void {
    let mut welcome = greet("Hello, ", "Ferret")
    welcome = append_label(welcome, " Playground")

    let len_before = welcome.Len()
    let cap_before = welcome.Capacity()

    welcome.Reserve(16)

    let view = welcome.AsStr()
    let bytes = welcome.Bytes()

    let mut draft = string::FromStr("draft")
    draft.Clear()

    if view == "Hello, Ferret! Playground" &&
        len_before == 25 &&
        cap_before >= 25 &&
        welcome.Capacity() >= 41 &&
        !welcome.IsEmpty() &&
        bytes[0] == b'H' &&
        bytes[7] == b'F' &&
        bytes[24] == b'd' &&
        view[7] == 'F' &&
        draft.IsEmpty() &&
        draft.AsStr() == "" {
        welcome.Release()
        draft.Release()
        print("string-stdlib-ok")
        return
    }

    welcome.Release()
    draft.Release()
    print("string-stdlib-fail")
    exit(1)
}
