import "std/io"
import "std/fs"

fn main() -> void {
    let mut file = fs::Open("io_file_write.txt")
    defer file.Close()

    _ = io::Write(file, "Hello") catch |err| {
        print(err)
        return
    }
    _ = io::Write(file, " World\n") catch |err| {
        print(err)
        return
    }
    _ = io::Write(file, to_str(132245)) catch |err| {
        print(err)
        return
    }
    //file.Close()
    
    
    let number : i16384 = 39999999999999999999999999999999
    println(number)
    println("Hello")
}
