fn count() -> i32 {
    let mut i = 0
    let mut sum = 0
    while i < 5 {
        sum = sum + 1
        i = i + 1
    }
    return sum
}

fn main() -> void {
    let size = comptime count()
    let items: [size]i32 = [size]i32{1, 2, 3, 4, 5}
    if items[4] == 5 {
        print("array-len-ok")
        return
    }
    panic "array length resolution failed"
}
