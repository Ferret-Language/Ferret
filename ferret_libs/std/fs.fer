// This file provides type declarations for type checking

// FileInfo contains metadata about a file
type FileInfo struct {
    .path: str,      // Full path to file
    .size: i64,      // Size in bytes
    .isDir: bool,    // True if directory
    .isFile: bool,   // True if regular file
    .exists: bool    // True if file exists
};

// File handle for reading/writing
type File struct {
    .handle: __file, // Internal compiler builtin file handle
    .path: str,      // Path that was opened
    .mode: str       // Mode: "r", "w", "a", "r+", "w+", "a+"
};

type FileMode enum {
    Read,
    Write,
    Append,
    ReadWrite,
    CreateRW,
    AppendRead
};

type SeekWhence enum {
    Start,
    Current,
    End
};

// Read entire file as string - simplest way to read a file
// Example: let content := fs::ReadFile("config.txt") catch err { ... };
fn ReadFile(path: str) -> str ! str {
    let file := Open(path, FileMode::Read) catch err {
        return err!;
    };
    defer file.Close();
    let out: []byte = [] as []byte;
    let bufSize: i32 = 32 * 1024;
    while true {
        let chunk := file.ReadBytes(bufSize) catch err {
            return err!;
        };
        if len(&chunk) == 0 {
            break;
        }
        if !_appendBytes(&mut out, chunk) {
            return "out of memory"!;
        }
    }
    return out as str;
}

// Write string to file (creates or overwrites)
// Example: fs::WriteFile("output.txt", "Hello!") catch err { ... };
fn WriteFile(path: str, content: str) -> str ! bool {
    let file := Create(path) catch err {
        return err!;
    };
    defer file.Close();
    let ok := file.WriteStr(content) catch err {
        return err!;
    };
    return ok;
}

// Append string to end of file
// Example: fs::AppendFile("log.txt", "New line\n") catch err { ... };
fn AppendFile(path: str, content: str) -> str ! bool {
    let file := OpenAppend(path) catch err {
        return err!;
    };
    defer file.Close();
    let ok := file.WriteStr(content) catch err {
        return err!;
    };
    return ok;
}

// ============================================
// File info functions
// ============================================

// Check if file or directory exists
// Example: if fs::Exists("config.txt") { ... }
// @extern
fn Exists(path: str) -> bool;

// Get file/directory information
// Example: let info := fs::Stat("myfile.txt") catch err { ... };
// @extern
fn Stat(path: str) -> str ! FileInfo;

// Get file size in bytes (convenience wrapper)
// Example: let size := fs::Size("data.bin") catch err { ... };
// @extern
fn Size(path: str) -> str ! i64;

// ============================================
// File handle operations (for large files)
// ============================================

// Open file by mode
// Example: let file := fs::Open("data.txt", fs::FileMode::Read) catch err { ... };
// @extern
fn Open(path: str, mode: FileMode) -> str ! File;

// Create/truncate file for writing
// Example: let file := fs::Create("output.txt") catch err { ... };
fn Create(path: str) -> str ! File {
    return Open(path, FileMode::Write) catch err {
        return err!;
    };
}

// Create/truncate file for reading and writing ("w+")
fn CreateRW(path: str) -> str ! File {
    return Open(path, FileMode::CreateRW) catch err {
        return err!;
    };
}

// Open file for appending
// Example: let file := fs::OpenAppend("log.txt") catch err { ... };
fn OpenAppend(path: str) -> str ! File {
    return Open(path, FileMode::Append) catch err {
        return err!;
    };
}

// Close file handle
// Example: file.Close();
// @extern
fn (f: File) Close();

// Read a line from file
// Example: let line := file.ReadLine() catch err { break; };
// @extern
fn (f: &mut File) ReadLine() -> str ! str;

// Read up to maxBytes from file as bytes
// Example: let chunk := file.ReadBytes(4096) catch err { ... };
// @extern
fn (f: &mut File) ReadBytes(maxBytes: i32) -> str ! []byte;

// Write string to file handle
// Example: file.WriteStr("data") catch err { ... };
// @extern
fn (f: &mut File) WriteStr(content: str) -> str ! bool;

// Write string with newline to file handle
// Example: file.WriteLine("line of text") catch err { ... };
// @extern
fn (f: &mut File) WriteLine(content: str) -> str ! bool;

// Move file cursor and return new absolute position
// Example: file.Seek(0, fs::SeekWhence::Start) catch err { ... };
// @extern
fn (f: &mut File) Seek(offset: i64, whence: SeekWhence) -> str ! i64;

fn (f: &mut File) Rewind() -> str ! i64 {
    return f.Seek(0, SeekWhence::Start) catch err {
        return err!;
    };
}

fn (f: &mut File) Read(maxBytes: i32) -> str ! []byte {
    return f.ReadBytes(maxBytes) catch err {
        return err!;
    };
}

// @extern
fn (f: &mut File) Write(buf: []byte) -> str ! i32;

// (no string wrapper; use WriteStr directly)

fn _appendBytes(dst: &mut []byte, src: []byte) -> bool {
    let i: i32 = 0;
    while i < len(&src) {
        if !append(dst, src[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// ============================================
// Directory operations
// ============================================

// Delete a file
// Example: fs::Remove("temp.txt") catch err { ... };
// @extern
fn Remove(path: str) -> str ! bool;

// Create a directory
// Example: fs::Mkdir("new_folder") catch err { ... };
// @extern
fn Mkdir(path: str) -> str ! bool;

// Remove empty directory
// Example: fs::Rmdir("empty_folder") catch err { ... };
// @extern
fn Rmdir(path: str) -> str ! bool;

// ============================================
// Path utilities
// ============================================

// Get current working directory
// Example: let cwd := fs::Cwd() catch err { ... };
// @extern
fn Cwd() -> str ! str;

// Join path components
// Example: let path := fs::Join("folder", "file.txt");  // -> "folder/file.txt"
// @extern
fn Join(base: str, path: str) -> str;

// Get file extension (including dot)
// Example: fs::Ext("file.txt")  // -> ".txt"
// @extern
fn Ext(path: str) -> str;

// Get base name (filename without directory)
// Example: fs::Base("/path/to/file.txt")  // -> "file.txt"
// @extern
fn Base(path: str) -> str;

// Get directory part of path
// Example: fs::Dir("/path/to/file.txt")  // -> "/path/to"
// @extern
fn Dir(path: str) -> str;
