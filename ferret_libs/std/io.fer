// Native IO module - implementations are in Go/C
// This file provides type declarations for type checking

// Printable union defines all types that can be printed
type Printable union {
    i8,
    i16,
    i32,
    i64,
    i128,
    i256,
    u8,
    u16,
    u32,
    u64,
    u128,
    u256,
    f32,
    f64,
    f128,
    f256,
    str,
    byte,
    char,
    bool,
    complex,
    complex64,
    complex256,
    complex512
};

// Streaming interfaces
type Reader interface {
    ~Read(maxBytes: i32) -> str ! []byte
};

type Writer interface {
    ~Write(buf: []byte) -> str ! i32
};

type Closer interface {
    ~Close()
};

type ReadWriter interface {
    ~Read(maxBytes: i32) -> str ! []byte,
    ~Write(buf: []byte) -> str ! i32
};

type StreamWriter struct {
    .stream: __stream
};

// @extern
fn (w: &mut StreamWriter) Write(buf: []byte) -> str ! i32;

fn Stdout() -> StreamWriter {
    return { .stream = stdout } as StreamWriter;
}

fn Stderr() -> StreamWriter {
    return { .stream = stderr } as StreamWriter;
}

// Private native helpers used by ferret-level wrappers.
// @extern
fn _formatPrintable(values: []Printable) -> str;
// @extern
fn _parseInt(value: str) -> str ! i32;
// @extern
fn _parseFloat(value: str) -> str ! f64;
// @extern
fn _readLine() -> str ! str;
// @extern
fn _readLineUnsafe() -> str;

fn Print(values: ...Printable) {
    let text := _formatPrintable(values);
    write(stdout, text as []byte) catch err {
        panic(err);
        return;
    };
}

fn Println(values: ...Printable) {
    let text := _formatPrintable(values) + "\n";
    write(stdout, text as []byte) catch err {
        panic(err);
        return;
    };
}

fn Read() -> str ! str {
    let line := _readLine() catch err {
        return err!;
    };
    return line;
}

fn ReadUnsafe() -> str {
    return _readLineUnsafe();
}

fn ReadInt() -> str ! i32 {
    let line := Read() catch err {
        return err!;
    };
    return _parseInt(line) catch err {
        return err!;
    };
}

fn ReadFloat() -> str ! f64 {
    let line := Read() catch err {
        return err!;
    };
    return _parseFloat(line) catch err {
        return err!;
    };
}

fn Write(data: []byte) -> str ! i32 {
    return write(stdout, data) catch err {
        return err!;
    };
}

fn WriteErr(data: []byte) -> str ! i32 {
    return write(stderr, data) catch err {
        return err!;
    };
}

fn FlushOut() -> str ! bool {
    return flush(stdout) catch err {
        return err!;
    };
}

fn FlushErr() -> str ! bool {
    return flush(stderr) catch err {
        return err!;
    };
}

fn ReadBytes(maxBytes: i32) -> str ! []byte {
    return read(stdin, maxBytes) catch err {
        return err!;
    };
}

fn Fprint(w: &mut Writer, values: ...Printable) -> str ! i32 {
    let text := _formatPrintable(values);
    return w.Write(text as []byte) catch err {
        return err!;
    };
}

fn Fprintln(w: &mut Writer, values: ...Printable) -> str ! i32 {
    let text := _formatPrintable(values) + "\n";
    return w.Write(text as []byte) catch err {
        return err!;
    };
}

fn _appendBytes(dst: &mut []byte, src: []byte) -> bool {
    let i: i32 = 0;
    while i < len(&src) {
        if !append(dst, src[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn WriteString(w: &mut Writer, s: str) -> str ! i32 {
    return w.Write(s as []byte) catch err {
        return err!;
    };
}

fn _sliceBytes(data: []byte, start: i32, end: i32) -> []byte {
    let out: []byte = [] as []byte;
    let i: i32 = start;
    let n := len(&data);
    let stop := end;
    while i < stop && i < n {
        append(&mut out, data[i]);
        i += 1;
    }
    return out;
}

fn WriteAll(dst: Writer, buf: []byte) -> str ! i32 {
    let total: i32 = 0;
    let pending := buf;
    while len(&pending) > 0 {
        let n := dst.Write(pending) catch err {
            return err!;
        };
        if n <= 0 {
            return "short write"!;
        }
        if n > len(&pending) {
            return "invalid write count"!;
        }
        total += n;
        if n == len(&pending) {
            break;
        }
        let current := pending;
        let plen := len(&current);
        pending = _sliceBytes(current, n, plen);
    }
    return total;
}

fn Copy(dst: Writer, src: Reader, bufSize: i32) -> str ! i64 {
    if bufSize <= 0 {
        return "bufSize must be > 0"!;
    }
    let total: i64 = 0;
    while true {
        let chunk := src.Read(bufSize) catch err {
            return err!;
        };
        let n := len(&chunk);
        if n == 0 {
            break;
        }
        let written := WriteAll(dst, chunk) catch err {
            return err!;
        };
        total = total + (written as i64);
    }
    return total;
}

fn ReadAll(src: Reader, bufSize: i32) -> str ! []byte {
    if bufSize <= 0 {
        return "bufSize must be > 0"!;
    }
    let out: []byte = [] as []byte;
    while true {
        let chunk := src.Read(bufSize) catch err {
            return err!;
        };
        if len(&chunk) == 0 {
            break;
        }
        if !_appendBytes(&mut out, chunk) {
            return "out of memory"!;
        }
    }
    return out;
}

fn Printf(fmt: str, args: ...Printable) {
    let count := 0, aCount := 0;
    let chars := fmt as []char;
    while count < len(&chars) {
        if count+1 < len(&chars) && chars[count] == '{' && chars[count+1] == '}' {
            Print(args[aCount]);
            count += 2;
            aCount++;
            continue;
        }
        Print(chars[count]);
        count++;
    }
}
