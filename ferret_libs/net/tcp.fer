// Native network module - transport primitives (TCP).
// Implementations live in C.

// IP address wrapper (optional helper type).
type IpAddr struct {
    .Value: str
};

// Socket address wrapper (host + port).
type SocketAddr struct {
    .Host: str,
    .Port: i32
};

// TCP listener handle.
type TcpListener struct {
    .handle: i64,
    .addr: str
};

// TCP connection handle.
type TcpConn struct {
    .handle: i64,
    .local: str,
    .remote: str
};

// Listen on address (e.g. "0.0.0.0:3000").
// @extern
fn ListenTcp(addr: str) -> str ! TcpListener;

// Dial a TCP address (e.g. "127.0.0.1:3000").
// @extern
fn DialTcp(addr: str) -> str ! TcpConn;

// Accept a new connection.
// @extern
fn (l: TcpListener) Accept() -> str ! TcpConn;

// Close a TCP listener.
// @extern
fn (l: TcpListener) Close();

// Read up to maxBytes into a byte slice.
// @extern
fn (c: TcpConn) Read(maxBytes: i32) -> str ! []byte;

// Read up to maxBytes and return as string.
// @extern
fn (c: TcpConn) ReadStr(maxBytes: i32) -> str ! str;

// Write bytes to the connection. Returns bytes written.
// @extern
fn (c: TcpConn) Write(buf: []byte) -> str ! i32;

// Write a string to the connection. Returns bytes written.
// @extern
fn (c: TcpConn) WriteStr(data: str) -> str ! i32;

// Close a TCP connection.
// @extern
fn (c: TcpConn) Close();

// Socket options.
// @extern
fn (c: TcpConn) SetReadTimeoutMs(ms: i32) -> str ! bool;
// @extern
fn (c: TcpConn) SetWriteTimeoutMs(ms: i32) -> str ! bool;
// @extern
fn (c: TcpConn) SetKeepAlive(enabled: bool) -> str ! bool;
