import "net/tcp" as net;

// Minimal Redis client over RESP (pure Ferret).

type Client struct {
    .conn: net::TcpConn
};


fn Connect(addr: str) -> str ! Client {
    let conn := net::DialTcp(addr) catch err {
        return err!;
    };
    return { .conn = conn };
}

fn (c: &mut Client) Close() {
    net::CloseConn(c.conn);
}

fn strLen(s: str) -> i32 {
    let bytes := s as []byte;
    return len(&bytes);
}

fn respBulk(s: str) -> str {
    return "$" + strLen(s) + "\r\n" + s + "\r\n";
}

fn buildCommand(args: []str) -> str {
    let out := "*" + len(&args) + "\r\n";
    let i: i32 = 0;
    while i < len(&args) {
        out = out + respBulk(args[i]);
        i += 1;
    }
    return out;
}

fn findCrlf(data: []byte, start: i32) -> i32 {
    let i: i32 = start;
    let n := len(&data);
    while i + 1 < n {
        if data[i] == 13 && data[i + 1] == 10 {
            return i;
        }
        i += 1;
    }
    return -1;
}

fn parseInt64(data: []byte, start: i32, end: i32) -> i64 {
    let i: i32 = start;
    if i >= end {
        return 0;
    }
    let sign: i64 = 1;
    if data[i] == 45 { // '-'
        sign = -1;
        i += 1;
    }
    let n: i64 = 0;
    while i < end {
        n = n * 10 + ((data[i] as i64) - 48);
        i += 1;
    }
    return n * sign;
}

fn parseInt32(data: []byte, start: i32, end: i32) -> i32 {
    let i: i32 = start;
    if i >= end {
        return 0;
    }
    let sign: i32 = 1;
    if data[i] == 45 { // '-'
        sign = -1;
        i += 1;
    }
    let n: i32 = 0;
    while i < end {
        n = n * 10 + ((data[i] as i32) - 48);
        i += 1;
    }
    return n * sign;
}

fn bytesToStr(data: []byte, start: i32, length: i32) -> str {
    let out := "";
    let i: i32 = 0;
    while i < length {
        out = out + data[start + i];
        i += 1;
    }
    return out;
}

fn parseRespStr(data: []byte) -> str ! ?str {
    let n := len(&data);
    if n <= 0 {
        return "empty response"!;
    }

    let prefix := data[0];
    let lineEnd := findCrlf(data, 1);
    if lineEnd < 0 {
        return "invalid response"!;
    }

    let lineStart: i32 = 1;
    let lineLen: i32 = lineEnd - lineStart;

    if prefix == 43 { // '+'
        return bytesToStr(data, lineStart, lineLen);
    }
    if prefix == 45 { // '-'
        return bytesToStr(data, lineStart, lineLen)!;
    }
    if prefix == 58 { // ':'
        let val := parseInt64(data, lineStart, lineEnd);
        return "" + val;
    }
    if prefix == 36 { // '$'
        let bulkLen := parseInt32(data, lineStart, lineEnd);
        if bulkLen < 0 {
            return none;
        }
        let bodyStart := lineEnd + 2;
        if bodyStart + bulkLen > n {
            return "invalid bulk response"!;
        }
        return bytesToStr(data, bodyStart, bulkLen);
    }
    if prefix == 42 { // '*'
        return "array replies not supported yet"!;
    }

    return "unknown response"!;
}

fn parseRespArray(data: []byte) -> str ! []?str {
    let n := len(&data);
    if n <= 0 {
        return "empty response"!;
    }
    let idx: i32 = 0;
    if data[idx] != 42 { // '*'
        return "unexpected reply type"!;
    }
    idx += 1;
    let lineEnd := findCrlf(data, idx);
    if lineEnd < 0 {
        return "invalid response"!;
    }
    let count := parseInt32(data, idx, lineEnd);
    idx = lineEnd + 2;

    let out: []?str = [] as []?str;
    if count <= 0 {
        return out;
    }

    let i: i32 = 0;
    while i < count {
        if idx >= n {
            return "invalid response"!;
        }
        let prefix := data[idx];
        idx += 1;

        if prefix == 43 { // '+'
            let e := findCrlf(data, idx);
            if e < 0 {
                return "invalid response"!;
            }
            let val := bytesToStr(data, idx, e - idx);
            idx = e + 2;
            append(&mut out, val);
            i += 1;
            continue;
        }
        if prefix == 45 { // '-'
            let e := findCrlf(data, idx);
            if e < 0 {
                return "invalid response"!;
            }
            let err := bytesToStr(data, idx, e - idx);
            return err!;
        }
        if prefix == 58 { // ':'
            let e := findCrlf(data, idx);
            if e < 0 {
                return "invalid response"!;
            }
            let val := parseInt64(data, idx, e);
            idx = e + 2;
            append(&mut out, "" + val);
            i += 1;
            continue;
        }
        if prefix == 36 { // '$'
            let e := findCrlf(data, idx);
            if e < 0 {
                return "invalid response"!;
            }
            let bulkLen := parseInt32(data, idx, e);
            idx = e + 2;
            if bulkLen < 0 {
                append(&mut out, none);
                i += 1;
                continue;
            }
            if idx + bulkLen > n {
                return "invalid bulk response"!;
            }
            let val := bytesToStr(data, idx, bulkLen);
            idx = idx + bulkLen + 2;
            append(&mut out, val);
            i += 1;
            continue;
        }
        if prefix == 42 { // '*'
            return "nested array replies not supported yet"!;
        }

        return "unknown response"!;
    }

    return out;
}

fn expectArrayStr(values: []?str) -> str ! []str {
    let out: []str = [];
    let i: i32 = 0;
    while i < len(&values) {
        let v := values[i];
        if v == none {
            return "nil array element"!;
        }
        append(&mut out, v ?? "");
        i += 1;
    }
    return out;
}

fn (c: &mut Client) readReplyOpt() -> str ! ?str {
    let data := net::Read(c.conn, 4096) catch err {
        return err!;
    };
    if len(&data) == 0 {
        return "connection closed"!;
    }
    return parseRespStr(data) catch err {
        return err!;
    };
}

fn (c: &mut Client) readReplyInt() -> str ! i64 {
    let data := net::Read(c.conn, 4096) catch err {
        return err!;
    };
    if len(&data) == 0 {
        return "connection closed"!;
    }
    let prefix := data[0];
    let lineEnd := findCrlf(data, 1);
    if lineEnd < 0 {
        return "invalid response"!;
    }

    if prefix == 45 { // '-'
        let text := bytesToStr(data, 1, lineEnd - 1);
        return text!;
    }
    if prefix != 58 { // ':'
        return "unexpected reply type"!;
    }
    return parseInt64(data, 1, lineEnd);
}

fn (c: &mut Client) readReplyArrayOpt() -> str ! []?str {
    let data := net::Read(c.conn, 4096) catch err {
        return err!;
    };
    if len(&data) == 0 {
        return "connection closed"!;
    }
    return parseRespArray(data) catch err {
        return err!;
    };
}

fn (c: &mut Client) readReplyArrayStr() -> str ! []str {
    let vals := c.readReplyArrayOpt() catch err {
        return err!;
    };
    return expectArrayStr(vals) catch err {
        return err!;
    };
}

fn (c: &mut Client) commandArgs(args: []str) -> str ! bool {
    let cmd := buildCommand(args);
    let written := net::WriteStr(c.conn, cmd) catch err {
        return err!;
    };
    return true;
}

fn (c: &mut Client) CommandArgs(args: []str) -> str ! str {
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    let val := c.readReplyOpt() catch err {
        return err!;
    };
    return val ?? "";
}

fn (c: &mut Client) CommandStr(args: ...str) -> str ! str {
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    let val := c.readReplyOpt() catch err {
        return err!;
    };
    return val ?? "";
}

fn (c: &mut Client) CommandInt(args: ...str) -> str ! i64 {
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyInt() catch err {
        return err!;
    };
}

fn (c: &mut Client) Ping() -> str ! str {
    return c.CommandStr("PING") catch err {
        return err!;
    };
}

fn (c: &mut Client) Get(key: str) -> str ! ?str {
    let ok := c.commandArgs(["GET", key]) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyOpt() catch err {
        return err!;
    };
}

fn (c: &mut Client) Set(key: str, value: str) -> str ! bool {
    let rep := c.CommandStr("SET", key, value) catch err {
        return err!;
    };
    return rep == "OK";
}

fn (c: &mut Client) Del(key: str) -> str ! i64 {
    return c.CommandInt("DEL", key) catch err {
        return err!;
    };
}

fn (c: &mut Client) Exists(key: str) -> str ! bool {
    let n := c.CommandInt("EXISTS", key) catch err {
        return err!;
    };
    return n > 0;
}

fn (c: &mut Client) Expire(key: str, seconds: i64) -> str ! bool {
    let n := c.CommandInt("EXPIRE", key, "" + seconds) catch err {
        return err!;
    };
    return n == 1;
}

fn (c: &mut Client) TTL(key: str) -> str ! i64 {
    return c.CommandInt("TTL", key) catch err {
        return err!;
    };
}

fn (c: &mut Client) Incr(key: str) -> str ! i64 {
    return c.CommandInt("INCR", key) catch err {
        return err!;
    };
}

fn (c: &mut Client) Decr(key: str) -> str ! i64 {
    return c.CommandInt("DECR", key) catch err {
        return err!;
    };
}

fn (c: &mut Client) MGet(keys: ...str) -> str ! []?str {
    if len(&keys) == 0 {
        return [] as []?str;
    }
    let args := ["MGET", ...keys];
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyArrayOpt() catch err {
        return err!;
    };
}

fn (c: &mut Client) MSet(pairs: ...str) -> str ! bool {
    let n := len(&pairs);
    if n == 0 {
        return "missing pairs"!;
    }
    if (n % 2) != 0 {
        return "mset requires even number of args"!;
    }
    let args := ["MSET", ...pairs];
    let rep := c.CommandArgs(args) catch err {
        return err!;
    };
    return rep == "OK";
}

fn (c: &mut Client) HSet(key: str, field: str, value: str) -> str ! i64 {
    return c.CommandInt("HSET", key, field, value) catch err {
        return err!;
    };
}

fn (c: &mut Client) HGet(key: str, field: str) -> str ! ?str {
    let ok := c.commandArgs(["HGET", key, field]) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyOpt() catch err {
        return err!;
    };
}

fn (c: &mut Client) HMGet(key: str, fields: ...str) -> str ! []?str {
    if len(&fields) == 0 {
        return [] as []?str;
    }
    let args := ["HMGET", key, ...fields];
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyArrayOpt() catch err {
        return err!;
    };
}

fn (c: &mut Client) HDel(key: str, fields: ...str) -> str ! i64 {
    if len(&fields) == 0 {
        return 0;
    }
    let args := ["HDEL", key, ...fields];
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyInt() catch err {
        return err!;
    };
}

fn (c: &mut Client) HGetAll(key: str) -> str ! map[str]str {
    let ok := c.commandArgs(["HGETALL", key]) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    let vals := c.readReplyArrayOpt() catch err {
        return err!;
    };
    let out: map[str]str;
    let n := len(&vals);
    if (n % 2) != 0 {
        return "invalid hash reply"!;
    }
    let i: i32 = 0;
    while i < n {
        let k := vals[i];
        let v := vals[i + 1];
        if k == none || v == none {
            return "nil hash field"!;
        }
        out[k ?? ""] = v ?? "";
        i += 2;
    }
    return out;
}

fn (c: &mut Client) SAdd(key: str, members: ...str) -> str ! i64 {
    if len(&members) == 0 {
        return 0;
    }
    let args := ["SADD", key, ...members];
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyInt() catch err {
        return err!;
    };
}

fn (c: &mut Client) SRem(key: str, members: ...str) -> str ! i64 {
    if len(&members) == 0 {
        return 0;
    }
    let args := ["SREM", key, ...members];
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyInt() catch err {
        return err!;
    };
}

fn (c: &mut Client) SIsMember(key: str, member: str) -> str ! bool {
    let n := c.CommandInt("SISMEMBER", key, member) catch err {
        return err!;
    };
    return n == 1;
}

fn (c: &mut Client) SMembers(key: str) -> str ! []str {
    let ok := c.commandArgs(["SMEMBERS", key]) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyArrayStr() catch err {
        return err!;
    };
}

fn (c: &mut Client) LPush(key: str, values: ...str) -> str ! i64 {
    if len(&values) == 0 {
        return 0;
    }
    let args := ["LPUSH", key, ...values];
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyInt() catch err {
        return err!;
    };
}

fn (c: &mut Client) RPush(key: str, values: ...str) -> str ! i64 {
    if len(&values) == 0 {
        return 0;
    }
    let args := ["RPUSH", key, ...values];
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyInt() catch err {
        return err!;
    };
}

fn (c: &mut Client) LPop(key: str) -> str ! ?str {
    let ok := c.commandArgs(["LPOP", key]) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyOpt() catch err {
        return err!;
    };
}

fn (c: &mut Client) RPop(key: str) -> str ! ?str {
    let ok := c.commandArgs(["RPOP", key]) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyOpt() catch err {
        return err!;
    };
}

fn (c: &mut Client) LLen(key: str) -> str ! i64 {
    return c.CommandInt("LLEN", key) catch err {
        return err!;
    };
}

fn (c: &mut Client) LRange(key: str, start: i64, stop: i64) -> str ! []str {
    let ok := c.commandArgs(["LRANGE", key, "" + start, "" + stop]) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyArrayStr() catch err {
        return err!;
    };
}
