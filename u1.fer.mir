module Ferret/u1

fn main() -> void {
  block b1 entry:
    %t1 = alloca i32
    %t2 = const i32 10
    store %t1, %t2
    %t3 = alloca bool
    %t4 = load i32 %t1
    %t5 = const i32 3
    %t6 = >= bool %t4, %t5
    %t7 = const bool 0
    store %t3, %t7
    br_if %t6, b2, b3
  block b2 and_or.right:
    %t8 = load i32 %t1
    %t9 = const i32 15
    %t10 = < bool %t8, %t9
    store %t3, %t10
    br b3
  block b3 and_or.merge:
    %t11 = load bool %t3
    br_if %t11, b4, b5
  block b4 if.then:
    %t12 = const i64 36
    %t13 = const i32 1
    %t14 = call ferret_array_new(%t12, %t13) : []Printable
    %t15 = const str a is within 0 to 15
    %t16 = alloca union {i8, i16, i32, i64, i128, i256, u8, u16, u32, u64, u128, u256, f32, f64, f128, f256, str, byte, char, bool}
    %t17 = ptr_add i32 %t16, 0
    %t18 = const i32 16
    store %t17, %t18
    %t19 = ptr_add str %t16, 4
    store %t19, %t15
    call ferret_array_append(%t14, %t16) : bool
    call io::Println(%t14) : void
    br b5
  block b5 if.end:
    ret
}
