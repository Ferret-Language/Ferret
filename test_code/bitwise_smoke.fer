import "std/io";

fn main() {
    let a: i32 = 6;
    let b: i32 = 3;
    io::Println(a & b);
    io::Println(a | b);
    io::Println(a ^ b);
    io::Println(~a);

    let x: i128 = 5;
    let y: i128 = 2;
    let z := x & y;
    let w := x | y;
    let n := ~x;
    io::Println(z);
    io::Println(w);
    io::Println(n);

    let ua: u256 = 1;
    let ub: u256 = 2;
    let uc := ua ^ ub;
    let ud := ~ua;
    io::Println(uc);
    io::Println(ud);
}
