// Global builtins implicitly available in every module.
//
// `str` is the built-in immutable text view type: an opaque fat pointer
// `{ data *u8, len usize }`.
// Assigning or passing `str` copies only this small view, not the backing bytes.
// The helper declarations below use references to pass view descriptors across
// the runtime FFI boundary.
// String literals have type `str`. Use str_data(s) and str_len(s) to extract
// the raw fields at C FFI boundaries.
//
// `^T` is the Ferret raw pointer form for C-style unchecked pointers.
// Use it at FFI boundaries where C expects `void *`. Use an unsafe cast to
// convert to a typed pointer: `unsafe raw_ptr as ^u8`.
//
// `recover` is a foreign function declaration. Panic lowering goes straight to the
// runtime hook `global__panic` and is not callable from source.

// Returns the panic message of the current panic as a str.
// When there is no active panic, returns an empty str (data=nil, len=0).
#[extern]
fn recover() -> str;

// `Any` is the canonical empty-interface "accepts all types" surface.
// Use it at API boundaries that intentionally accept arbitrary concrete values.
type Any interface {}

// Temporary generic print declaration.
// Accepts any number of values and prints each with a best-effort textual form to stdout.
#[extern]
fn print(values: ...Any);

#[allow_unused]
fn println(values: ...Any) {
    print(values...)
    print("\n")
}

// Returns the element count of an array or slice.
// This foreign declaration is polymorphic in semantic analysis and accepts any []T or [N]T.
#[extern("ferret_global_slice_len")]
fn len(value: []u8) -> usize;

// Internal helper used by lowering of len on slice values.
#[extern]
fn slice_len(value: ^void) -> usize;

// Returns current entry count of a map.
#[extern]
fn size<K: Comparable, V>(value: &map[K]V) -> usize;

// Returns current slot capacity of a map.
#[extern]
fn cap<K: Comparable, V>(value: &map[K]V) -> usize;

// Looks up a key and returns `none` when key is absent.
#[extern]
fn get<K: Comparable, V>(value: &map[K]V, key: K) -> ?V;

// Inserts or overwrites a key and returns previous value when key existed.
#[extern]
fn set<K: Comparable, V>(value: &mut map[K]V, key: K, item: V) -> ?V;

// Reports a compile-time error with the provided message.
// Valid only when evaluated in a comptime context.
#[extern]
fn compile_error(message: str) -> void;

// Converts Stringable values to text when formatting or encoding is required.
// Numeric types, str, []char, and types with String(self) -> str satisfy Stringable.
// Use `as` for zero-copy reshapes.
// Warning: `[]u8 as str` creates a trusted view and does not validate UTF-8.
// Cast arbitrary bytes only when they are already known to be valid UTF-8.
#[extern]
fn to_str<T: Stringable>(value: T) -> str;

// ---------------------------------------------------------------------------
// str field accessors
//
// `str` is opaque — you cannot directly access its fields.
// Use these builtins at `#[extern]` call sites to cross the C FFI boundary.
// ---------------------------------------------------------------------------

// Returns the raw byte pointer that backs s.
// Valid only as long as s is live. Do not store without care.
#[extern]
fn str_data(s: &str) -> ^void;

// Returns the byte length of s (number of UTF-8 code units / bytes).
#[extern]
fn str_len(s: &str) -> usize;

// Copies the UTF-8 bytes of s into a fresh []u8 slice.
// Use `s as []u8` when a readonly byte view is enough.
#[extern]
fn str_bytes(s: &str) -> []u8;

// Copies the bytes of a []u8 slice into a fresh str value.
// This is explicit because the operation allocates and trusts caller UTF-8.
#[extern]
fn bytes_str(bytes: &[]u8) -> str;

// Decodes the UTF-8 bytes of s into a fresh []char slice.
#[extern]
fn str_chars(s: &str) -> []char;

// Runtime target used by to_str([]char).
#[extern]
fn chars_str(chars: &[]char) -> str;

// Copies s into a newly allocated NUL-terminated C string.
// The returned pointer can be passed to C APIs and freed with free().
#[extern]
fn str_cstr(s: &str) -> ^void;

// Runtime targets used by to_str(numeric).
#[extern]
fn i64_str(value: i64) -> str;

#[extern]
fn u64_str(value: u64) -> str;

#[extern]
fn f64_str(value: f64) -> str;

// ---------------------------------------------------------------------------
// Memory management (libc)
//
// All functions use ^void matching actual libc signatures.
// Cast to a typed pointer with unsafe: `unsafe malloc(n) as ^u8`
// ---------------------------------------------------------------------------

// Allocates size uninitialized bytes. Returns a nil pointer on failure.
#[extern("malloc")]
fn malloc(size: usize) -> ^void;

// Frees memory previously obtained from malloc, calloc, or realloc.
#[extern("free")]
fn free(ptr: ^void) -> void;

// Resizes a previously allocated block to size bytes.
// Returns the (possibly moved) new pointer, or nil on failure.
#[extern("realloc")]
fn realloc(ptr: ^void, size: usize) -> ^void;

// Allocates count * size zero-initialised bytes. Returns nil on failure.
#[extern("calloc")]
fn calloc(count: usize, size: usize) -> ^void;

// Copies n bytes from src to dst. Regions must not overlap.
#[extern("memcpy")]
fn memcpy(dst: ^void, src: ^void, n: usize) -> ^void;

// Copies n bytes from src to dst, handling overlap correctly.
#[extern("memmove")]
fn memmove(dst: ^void, src: ^void, n: usize) -> ^void;

// Fills the first n bytes at ptr with the byte value c (low 8 bits used).
#[extern("memset")]
fn memset(ptr: ^void, c: i32, n: usize) -> ^void;

// Compares n bytes of a and b.
// Returns 0 if equal, negative if a < b, positive if a > b.
#[extern("memcmp")]
fn memcmp(a: ^void, b: ^void, n: usize) -> i32;

// ---------------------------------------------------------------------------
// Process
// ---------------------------------------------------------------------------

// Terminates the process immediately with the given exit code.
#[extern("exit")]
fn exit(code: i32) -> void;
