// std/mem — allocator surface for explicit memory management.
//
// This module is intentionally thin for v0:
// - allocator API is explicit and library-defined (not compiler hardcoded)
// - implementation is backed by libc allocation externs from global.fer
// - raw pointers stay unsafe at use-sites (`^T` / `^const T`)

// Allocator is the common allocation interface.
//
// Methods return `^void` for raw byte ownership at the FFI boundary.
// Callers cast to typed raw pointers in `unsafe { ... }` when needed.
type Allocator interface {
    Alloc(&self, size: usize) -> ^void
    AllocZeroed(&self, size: usize) -> ^void
    Realloc(&self, ptr: ^void, size: usize) -> ^void
    Free(&self, ptr: ^void) -> void
}

// Expose converts an owning pointer into a raw pointer without changing bits.
//
// This is an explicit ownership-boundary API; use inside `unsafe` when handing
// ownership-managed values to low-level/FFI code.
#[extern]
fn Expose<T>(owner: *T) -> ^T;

// ExposeRef borrows an owning pointer and returns its raw address bits.
//
// This does not consume ownership. Use inside `unsafe` when low-level code
// needs a raw view of an owning pointer's address without moving it.
#[extern]
fn ExposeRef<T>(owner: &*T) -> ^T;

// Adopt converts a raw pointer into an owning pointer without changing bits.
//
// This is an explicit ownership-boundary API; use inside `unsafe` only when
// provenance is trusted (allocator + lifetime contract are compatible).
#[extern]
fn Adopt<T>(raw: ^T) -> *T;

// CAllocator is the default system allocator backed by libc.
type CAllocator struct {}

// PageAllocator keeps a page-granularity allocation surface.
//
// Current implementation is libc-backed with page-sized rounding.
// OS-native page mapping (mmap/VirtualAlloc) can replace internals later
// without changing the user-facing API.
type PageAllocator struct {}

// ArenaAllocator is a bump allocator for fast transient allocations.
//
// It owns one growing block and never frees individual allocations.
// Use Reset() to reuse capacity, and Release() to free backing memory.
type ArenaAllocator struct {
    base: ^void
    cap: usize = 0
    used: usize = 0
}

const PageSize: usize = 4096

fn align_up(value: usize, align: usize) -> usize {
    if align == 0 {
        return value
    }
    let rem = value % align
    if rem == 0 {
        return value
    }
    return value + (align - rem)
}

fn ptr_add(base: ^void, offset: usize) -> ^void {
    let mut out = base
    unsafe {
        let addr = base as usize
        out = (addr + offset) as ^void
    }
    return out
}

// Alloc allocates `size` uninitialized bytes.
fn CAllocator::Alloc(&self, size: usize) -> ^void {
    return malloc(size)
}

// AllocZeroed allocates `size` zero-initialized bytes.
fn CAllocator::AllocZeroed(&self, size: usize) -> ^void {
    return calloc(1, size)
}

// Realloc resizes a previous allocation.
fn CAllocator::Realloc(&self, ptr: ^void, size: usize) -> ^void {
    return realloc(ptr, size)
}

// Free releases memory allocated by this allocator.
fn CAllocator::Free(&self, ptr: ^void) -> void {
    free(ptr)
}

// System returns the default libc-backed allocator.
fn System() -> CAllocator {
    return .{}
}

// Page returns a page-granularity allocator.
fn Page() -> PageAllocator {
    return .{}
}

fn PageAllocator::Alloc(&self, size: usize) -> ^void {
    return malloc(align_up(size, PageSize))
}

fn PageAllocator::AllocZeroed(&self, size: usize) -> ^void {
    return calloc(1, align_up(size, PageSize))
}

fn PageAllocator::Realloc(&self, ptr: ^void, size: usize) -> ^void {
    return realloc(ptr, align_up(size, PageSize))
}

fn PageAllocator::Free(&self, ptr: ^void) -> void {
    free(ptr)
}

// Arena creates a bump allocator with an optional initial capacity.
fn Arena(initial_capacity: usize) -> ArenaAllocator {
    return .{
        .base = malloc(initial_capacity),
        .cap = initial_capacity,
        .used = 0
    }
}

fn ArenaAllocator::Alloc(&mut self, size: usize) -> ^void {
    if size == 0 {
        return ptr_add(self.base, self.used)
    }
    let needed = self.used + size
    if needed > self.cap {
        let mut next = self.cap
        if next == 0 {
            next = 64
        }
        while next < needed {
            next = next + next
        }
        self.base = realloc(self.base, next)
        self.cap = next
    }
    let ptr = ptr_add(self.base, self.used)
    self.used = needed
    return ptr
}

fn ArenaAllocator::AllocZeroed(&mut self, size: usize) -> ^void {
    let ptr = self.Alloc(size)
    memset(ptr, 0, size)
    return ptr
}

// Arena Realloc allocates a new chunk and copies `size` bytes.
//
// This is useful when the old size is known by caller convention.
fn ArenaAllocator::Realloc(&mut self, ptr: ^void, size: usize) -> ^void {
    let next = self.Alloc(size)
    memmove(next, ptr, size)
    return next
}

// Arena Free is a no-op for individual pointers.
fn ArenaAllocator::Free(&mut self, ptr: ^void) -> void {
    ptr
}

// Reset drops all bump allocations while retaining capacity.
fn ArenaAllocator::Reset(&mut self) -> void {
    self.used = 0
}

// Release frees the backing block and resets the arena state.
fn ArenaAllocator::Release(&mut self) -> void {
    free(self.base)
    unsafe {
        self.base = 0 as ^void
    }
    self.cap = 0
    self.used = 0
}

// Alloc forwards allocation through any allocator implementation.
fn Alloc(a: Allocator, size: usize) -> ^void {
    return a.Alloc(size)
}

// AllocAs forwards allocation and returns a typed raw pointer.
fn AllocAs<T>(a: Allocator, size: usize) -> ^T {
    unsafe {
        return Alloc(a, size) as ^T
    }
}

// AllocZeroed forwards zeroed allocation through any allocator implementation.
fn AllocZeroed(a: Allocator, size: usize) -> ^void {
    return a.AllocZeroed(size)
}

// AllocZeroedAs forwards zeroed allocation and returns a typed raw pointer.
fn AllocZeroedAs<T>(a: Allocator, size: usize) -> ^T {
    unsafe {
        return AllocZeroed(a, size) as ^T
    }
}

// Realloc forwards resize through any allocator implementation.
fn Realloc(a: Allocator, ptr: ^void, size: usize) -> ^void {
    return a.Realloc(ptr, size)
}

// ReallocAs forwards resize for typed raw pointers.
fn ReallocAs<T>(a: Allocator, ptr: ^T, size: usize) -> ^T {
    unsafe {
        return Realloc(a, ptr as ^void, size) as ^T
    }
}

// Free forwards deallocation through any allocator implementation.
fn Free(a: Allocator, ptr: ^void) -> void {
    a.Free(ptr)
}

// FreeAs forwards deallocation for typed raw pointers.
fn FreeAs<T>(a: Allocator, ptr: ^T) -> void {
    unsafe {
        Free(a, ptr as ^void)
    }
}

// AllocOwnedAs allocates bytes and adopts them as an owning pointer.
fn AllocOwnedAs<T>(a: Allocator, size: usize) -> *T {
    unsafe {
        return Adopt(Alloc(a, size) as ^T)
    }
}

// ReallocOwnedAs resizes an owning pointer and returns a re-adopted owner.
fn ReallocOwnedAs<T>(a: Allocator, ptr: *T, size: usize) -> *T {
    unsafe {
        let raw = Expose(ptr)
        let next = Realloc(a, raw as ^void, size)
        return Adopt(next as ^T)
    }
}

// FreeOwned releases an owning pointer through an allocator boundary.
fn FreeOwned<T>(a: Allocator, ptr: *T) -> void {
    unsafe {
        Free(a, Expose(ptr) as ^void)
    }
}
