/// Standard IO library for Ferret.
/// Provides Go-style Writer and Reader types backed by libc file descriptors.
///
/// Type conventions at the libc boundary:
///   *raw u8      — pointer to immutable bytes (C: const unsigned char *)
///   *raw mut u8  — pointer to mutable bytes   (C: unsigned char *)
///   *raw void    — untyped C void*, used for write/read (POSIX: const void *)
///
/// `str` is opaque inside Ferret. At the C boundary, use str_data(s) to get
/// the byte pointer and str_len(s) to get the byte count.

// ---------------------------------------------------------------------------
// Libc bindings — raw byte-pointer FFI surface
// ---------------------------------------------------------------------------

/// Write up to count bytes from buf to file descriptor fd.
/// Returns the number of bytes written, or -1 on error.
#[extern("write")]
fn write(fd i32, buf *raw void, count usize) isize;

/// Read up to count bytes from fd into buf.
/// Returns bytes read, 0 on EOF, or -1 on error.
#[extern("read")]
fn read(fd i32, buf *raw void, count usize) isize;

/// Open or create a file.
/// flags: O_RDONLY=0, O_WRONLY=1, O_RDWR=2, O_CREAT=64, O_TRUNC=512.
/// path must be a NUL-terminated C string; pass str_data(path_str).
/// Returns the new file descriptor, or -1 on error.
#[extern("open")]
fn open(path *raw u8, flags i32, mode u32) i32;

/// Close a file descriptor. Returns 0 on success or -1 on error.
#[extern("close")]
fn close(fd i32) i32;

/// Reposition the file offset.
/// whence: SEEK_SET=0, SEEK_CUR=1, SEEK_END=2.
/// Returns the resulting offset from the beginning, or -1 on error.
#[extern("lseek")]
fn lseek(fd i32, offset isize, whence i32) isize;

// ---------------------------------------------------------------------------
// Writer
// ---------------------------------------------------------------------------

/// Writer wraps a file descriptor for sequential byte output.
/// Obtain one via Stdout(), Stderr(), or construct .{ .fd = n } directly.
type Writer struct {
    fd i32
}

/// WriteStr writes the UTF-8 bytes of s to the writer.
/// This is the idiomatic way to write a Ferret string.
/// Returns the number of bytes written, or a negative value on error.
fn (w Writer) WriteStr(s *str) isize {
    return write(w.fd, str_data(s), str_len(s))
}

/// WriteBytes writes count raw bytes from buf to the writer.
/// Use this when you already have a raw pointer (e.g. from a C library).
/// Returns the number of bytes written, or a negative value on error.
fn (w Writer) WriteBytes(buf *raw void, count usize) isize {
    return write(w.fd, buf, count)
}

// ---------------------------------------------------------------------------
// Reader
// ---------------------------------------------------------------------------

/// Reader wraps a file descriptor for sequential byte input.
/// Obtain one via Stdin() or construct .{ .fd = n } directly.
type Reader struct {
    fd i32
}

/// ReadBytes reads up to count bytes from the reader into buf.
/// Returns the number of bytes read, 0 on EOF, or a negative value on error.
fn (r Reader) ReadBytes(buf *raw void, count usize) isize {
    return read(r.fd, buf, count)
}

// ---------------------------------------------------------------------------
// Standard file descriptors
// ---------------------------------------------------------------------------

/// Stdout returns a Writer connected to process standard output (fd 1).
fn Stdout() Writer {
    return .{ .fd = 1 }
}

/// Stderr returns a Writer connected to process standard error (fd 2).
fn Stderr() Writer {
    return .{ .fd = 2 }
}

/// Stdin returns a Reader connected to process standard input (fd 0).
fn Stdin() Reader {
    return .{ .fd = 0 }
}

/// Println writes s followed by a newline to stdout.
fn Println(s str) {
    write(1, str_data(&s), str_len(&s))
    let newline = "\n"
    write(1, str_data(&newline), 1)
}
