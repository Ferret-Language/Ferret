import "std/io";

fn main() {
    // First value is small (i32), middle value needs i128
    let ages := {
        "alice" => 25,                           // i32
        "bob" => 999999999999999999999999999999,  // i128
        "charlie" => 30                          // i32
    };
    
    io::Println("Map created with mixed sizes\n");
}
