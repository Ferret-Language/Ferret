func Assignable(dst, src Type) bool {
	if dst == nil && src == nil {
		return true
	}
	if IsInvalid(dst) || IsInvalid(src) || IsUnknown(dst) || IsUnknown(src) {
		return true
	}
	if Equal(dst, src) {
		return true
	}
	if IsImplicitNumericWidening(dst, src) {
		return true
