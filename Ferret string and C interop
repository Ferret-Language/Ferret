func qbeLoadOp(typ typeinfo.Type) (string, string, error) {
	switch base := unwrapNamed(typ).(type) {
	case *typeinfo.BuiltinType:
		switch base.Name {
		case "bool", "u8":
			return "loadub", "w", nil
		case "i8":
			return "loadsb", "w", nil
		case "u16":
			return "loaduh", "w", nil
		case "i16":
			return "loadsh", "w", nil
		case "u32", "i32", "char":
			return "loadw", "w", nil
		case "u64", "i64", "usize", "isize":
			return "loadl", "l", nil
		case "f32":
			return "loads", "s", nil
		case "f64":
			return "loadd", "d", nil
		}
	case *typeinfo.PointerType:
		return "loadl", "l", nil
	}

