func llvmMemcpy(dst, src string, size, align int64) string {
	if align <= 0 {
		align = 1
	}
	return fmt.Sprintf("call void @llvm.memcpy.p0.p0.i64(ptr align %d %s, ptr align %d %s, i64 %d, i1 false)",
		align, dst, align, src, size)
}

