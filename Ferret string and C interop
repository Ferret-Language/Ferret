// RuntimeStaticLib returns the path to a cached ferret_runtime.a static
// archive, compiling it from ferret_runtime.c on first call.
//
// The archive is stored in the OS user-cache directory under
// ferret/runtime-<sha256[:12]>/ferret_runtime.a so it is rebuilt only when
// the source file changes.
func RuntimeStaticLib() (string, error) {
	runtimeLibOnce.Do(func() {
		runtimeLibPath, runtimeLibErr = ensureRuntimeLib()
	})
	return runtimeLibPath, runtimeLibErr
}

func ensureRuntimeLib() (string, error) {
	src, err := findRuntimeCFile()
	if err != nil {
		return "", err
	}

	// Hash the source so the cache is invalidated whenever the file changes.
	content, err := os.ReadFile(src)
	if err != nil {
		return "", fmt.Errorf("ferret runtime: read %s: %w", src, err)
	}
	sum := sha256.Sum256(content)
	key := fmt.Sprintf("%x", sum[:6]) // 12 hex chars — enough to avoid collisions

	cacheDir, err := os.UserCacheDir()
	if err != nil {
		return "", fmt.Errorf("ferret runtime: user cache dir: %w", err)
	}
	libDir := filepath.Join(cacheDir, "ferret", "runtime-"+key)
	libPath := filepath.Join(libDir, "ferret_runtime.a")

	// Fast path: already compiled.
	if info, err := os.Stat(libPath); err == nil && info.Size() > 0 {
		return libPath, nil
	}

	if err := os.MkdirAll(libDir, 0o755); err != nil {
		return "", fmt.Errorf("ferret runtime: mkdir %s: %w", libDir, err)
	}

	// Compile to an object file then archive it.
	objPath := filepath.Join(libDir, "ferret_runtime.o")
	ccCompile := exec.Command("cc", "-O2", "-c", src, "-o", objPath)
	if out, err := ccCompile.CombinedOutput(); err != nil {
		return "", fmt.Errorf("ferret runtime: compile: %w\n%s", err, out)
	}

	arCmd := exec.Command("ar", "rcs", libPath, objPath)
	if out, err := arCmd.CombinedOutput(); err != nil {
		_ = os.Remove(objPath)
		return "", fmt.Errorf("ferret runtime: archive: %w\n%s", err, out)
	}

	// Object file is no longer needed once archived.
	_ = os.Remove(objPath)
	return libPath, nil
}

// findRuntimeCFile locates ferret_runtime.c on disk.
//
// Search order:
//  1. Executable-relative: binary lives in bin/, runtime is at ../runtime/.
//  2. Walk up from the working directory — covers development checkouts.
func findRuntimeCFile() (string, error) {
	var candidates []string

	if execPath, err := os.Executable(); err == nil {
		execDir := filepath.Dir(execPath)
		candidates = append(candidates,
			filepath.Join(execDir, "..", "runtime", "ferret_runtime.c"),
			filepath.Join(execDir, "runtime", "ferret_runtime.c"),
		)
	}

	if wd, err := os.Getwd(); err == nil {
		for current := wd; ; current = filepath.Dir(current) {
			candidates = append(candidates,
				filepath.Join(current, "runtime", "ferret_runtime.c"),
			)
			parent := filepath.Dir(current)
			if parent == current {
				break
			}
		}
	}

	seen := make(map[string]struct{}, len(candidates))
	for _, c := range candidates {
		if c == "" {
			continue
		}
		clean := filepath.Clean(c)
		if _, ok := seen[clean]; ok {
			continue
		}
		seen[clean] = struct{}{}
		if info, err := os.Stat(clean); err == nil && !info.IsDir() {
			return clean, nil
		}
	}
	return "", fmt.Errorf("ferret runtime: ferret_runtime.c not found; searched relative to executable and working directory")
}

