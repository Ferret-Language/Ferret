}

func qbeExtType(typ typeinfo.Type) (string, error) {
	// str and []T are fat-pointer aggregates; not valid as plain struct-member ext types.
	if typeinfo.IsStr(typ) {
		return "", fmt.Errorf("str is a fat-pointer aggregate, not a scalar member type")
	}
	if _, ok := typ.(*typeinfo.SliceType); ok {
		return "", fmt.Errorf("[]T is a fat-pointer aggregate, not a scalar member type")
	}
	switch base := unwrapNamed(typ).(type) {
	case *typeinfo.BuiltinType:
		switch base.Name {
		case "bool", "u8", "i8":
			return "b", nil
		case "u16", "i16":
			return "h", nil
		case "u32", "i32", "char":
			return "w", nil
		case "u64", "i64", "usize", "isize":
			return "l", nil
		case "f32":
			return "s", nil
		case "f64":
			return "d", nil
		}
	case *typeinfo.PointerType:
