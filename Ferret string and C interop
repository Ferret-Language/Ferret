	case *typeinfo.BuiltinType:
		switch base.Name {
		case "bool", "u8", "i8":
			return "b", nil
		case "u16", "i16":
			return "h", nil
		case "u32", "i32", "char":
			return "w", nil
		case "u64", "i64", "usize", "isize":
			return "l", nil
		case "f32":
			return "s", nil
		case "f64":
