import "std/io";
import "shapes";

fn main() {
    // This should trigger the lookupTypeSymbol function to search through
    // imported modules when it encounters the imported types
    
    let rect: shapes::Rectangle = {
        .Width = 10,
        .Height = 20
    };
    
    let circle: shapes::Circle = {
        .Radius = 5.0
    };
    
    // Use a union type from the imported module
    let shape: shapes::Shape = rect;
    
    io::Println("Rectangle area:", rect.area());
    io::Println("Circle area:", circle.area());
    io::Println("Shape created successfully");
}