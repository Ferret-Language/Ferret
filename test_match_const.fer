import "std/io";

fn main() {
    let x := 5;

    // Test 1: Always matches first case
    match x {
        5 => io::Println("case 1"),
        10 => io::Println("case 2"), // Never reached
        _ => io::Println("default"), // Never reached
    }

    // Test 2: Never matches case
    match x {
        10 => io::Println("case 10"), // Never matches
        20 => io::Println("case 20"), // Never matches
        _ => io::Println("default"), // Always matches
    }

    // Test 3: Range check - always matches
    match x {
        in 3..10 => io::Println("in range"),
        _ => io::Println("out of range"), // Never reached
    }

    // Test 4: Range check - never matches
    match x {
        in 20..30 => io::Println("in high range"), // Never matches
        _ => io::Println("not in high range"),
    }

    // Test 5: Multiple ranges
    match x {
        in 1..3 => io::Println("low"), // Never matches
        in 3..7 => io::Println("mid"), // Always matches
        in 7..10 => io::Println("high"), // Never reached
        _ => io::Println("other"), // Never reached
    }
}
