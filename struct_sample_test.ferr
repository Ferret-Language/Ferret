type Point struct {
    X: i32 = 1
    Y: i32 = 2
}

type Circle struct {
    Rad: f32
}

fn Circle::Show(&self) {
    print("I am a circle")
}

fn Point::Show(&self) {
    print("I am a point")
}

type Shape interface{
    Show(&self)
}

fn who(s: Shape) {
    s.Show()
}

fn main() i32 {
    let mut p: Point = .{}
    //let px = p
    print(p.X)
    print(p.Y)
    let p2: Point = .{}
    print(p2.X)
    print(p2.Y)

    let mut maybe : ?i32 = none
    maybe = 21
    maybe = 66
    maybe = none

    let p3 = .{} as Point
    let c1 = .{ .Rad = 2.3 } as Circle

    who(p3)
    who(c1)

    return 0
}
