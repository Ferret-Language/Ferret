module struct_sample_test
type Point struct {
    X i32 = 0
    Y i32 = 0
    static Counter i32 = 0
}

const Point__Counter: i32 = 0

fn (p *mut local:struct_sample_test::Point) Point() void {
    io::Println("ctor")
    Point::Counter = Point::Counter + 1
}

fn (p *own local:struct_sample_test::Point) ~Point() void {
    io::Println("dtor")
}

fn main() i32 {
    let p: local:struct_sample_test::Point = .{ .X = 3, .Y = 4 }
    defer p.~Point()
    io::Println("value")
    return (p.X + p.Y) + Point::Counter
}
