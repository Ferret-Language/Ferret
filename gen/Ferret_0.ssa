data $str1 = { b "alpha", b 0 }
data $str2 = { b "beta", b 0 }
data $str3 = { b "key not found in map", b 0 }
data $str4 = { b "gamma", b 0 }

export function w $main() {
@b1
	%t1 =l alloc8 8
	%t4 =l alloc8 16
	%t5 =l alloc4 8
	%t22 =l alloc8 36
	%t35 =l alloc8 36
	%t2 =l copy 8
	%t3 =l copy 4
	%t6 =l copy $str1
	%t7 =w copy 1
	%t8 =l add %t4, 0
	%t9 =l add %t5, 0
	storel %t6, %t8
	storew %t7, %t9
	%t10 =l copy $str2
	%t11 =w copy 2
	%t12 =l add %t4, 8
	%t13 =l add %t5, 4
	storel %t10, %t12
	storew %t11, %t13
	%t14 =l copy 2
	%t15 =l call $ferret_map_from_pairs_str(l %t2, l %t3, l %t4, l %t5, l %t14)
	storel %t15, %t1
	%t16 =l copy 36
	%t17 =w copy 1
	%t18 =l call $ferret_array_new(l %t16, w %t17)
	%t19 =l loadl %t1
	%t20 =l copy $str1
	%q1 =l alloc8 8
	storel %t20, %q1
	%q2 =l call $ferret_map_get(l %t19, l %q1)
	%q3 =w ceql %q2, 0
	jnz %q3, @map_get_panic_0, @map_get_ok_1
	@map_get_panic_0
	call $ferret_global_panic(l $str3)
	ret
	@map_get_ok_1
	%t21 =w loadw %q2
	%t23 =l add %t22, 0
	%t24 =w copy 2
	storew %t24, %t23
	%t25 =l add %t22, 4
	storew %t21, %t25
	call $ferret_array_append(l %t18, l %t22)
	call $ferret_std_io_Println(l %t18)
	%t26 =l loadl %t1
	%t27 =l copy $str4
	%t28 =w copy 3
	%q4 =l alloc8 8
	storel %t27, %q4
	%q5 =l alloc4 4
	storew %t28, %q5
	call $ferret_map_set(l %t26, l %q4, l %q5)
	%t29 =l copy 36
	%t30 =w copy 1
	%t31 =l call $ferret_array_new(l %t29, w %t30)
	%t32 =l loadl %t1
	%t33 =l copy $str4
	%q6 =l alloc8 8
	storel %t33, %q6
	%q7 =l call $ferret_map_get(l %t32, l %q6)
	%q8 =w ceql %q7, 0
	jnz %q8, @map_get_panic_2, @map_get_ok_3
	@map_get_panic_2
	call $ferret_global_panic(l $str3)
	ret
	@map_get_ok_3
	%t34 =w loadw %q7
	%t36 =l add %t35, 0
	%t37 =w copy 2
	storew %t37, %t36
	%t38 =l add %t35, 4
	storew %t34, %t38
	call $ferret_array_append(l %t31, l %t35)
	call $ferret_std_io_Println(l %t31)
	ret 0
