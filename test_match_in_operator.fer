import "std/io";

// Test with union + is patterns combined
type Result union {
    i32,
    str
};

fn main() {
    let score := 85;
    
    // Test 'in' in match expression (should work since match is like if-else)
    match score {
        in 90..=100 => io::Println("Grade: A"),
        in 80..90   => io::Println("Grade: B"),
        in 70..80   => io::Println("Grade: C"),
        in 60..70   => io::Println("Grade: D"),
        _           => io::Println("Grade: F"),
    }
    
    // Test dead code detection in match with constants
    match 95 {
        in 90..=100 => io::Println("Constant match: A grade"),
        in 80..90   => io::Println("DEAD: never reaches here"),
        _           => io::Println("DEAD: never reaches here either"),
    }
    
    let result: Result = 42;
    
    match result {
        is i32 => {
            if result in 0..100 {
                io::Println("Integer result in range 0..100:", result);
            }
        },
        is str => io::Println("String result:", result),
        _ => io::Println("Unknown"),
    }
}
