import "std/io";

fn main() {
    // Test &&: second condition should not be evaluated if first is false
    let arr: [3]i32 = [1, 2, 3];
    let i := 10;
    
    // This should NOT panic because i < 3 is false, so arr[i] is never evaluated
    if i < 3 && arr[i] == 1 {
        io::Println("Should not reach here");
    } else {
        io::Println("&& short-circuit works: i >= 3, so arr[i] was not evaluated");
    }
    
    // Test ||: second condition should not be evaluated if first is true
    let j := 1;
    if j < 3 || arr[10] == 99 {
        io::Println("|| short-circuit works: j < 3 is true, so arr[10] was not evaluated");
    }
    
    // Test with bounds check that should pass
    let k := 1;
    if k < 3 && arr[k] == 2 {
        io::Println("Both conditions true: arr[1] == 2");
    }
}
