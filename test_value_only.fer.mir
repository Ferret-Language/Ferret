module Ferret/test_value_only

fn Counter_getValue(receiver c: &Counter) -> i32 {
  block b1 entry:
    %t2 = alloca Counter
    store %t2, %t1
    %t3 = ptr_add i32 %t2, 0
    %t4 = load i32 %t3
    ret %t4
}

fn main() -> void {
  block b2 entry:
    %t5 = alloca Counter
    %t6 = alloca Counter
    %t7 = const i32 42
    %t8 = ptr_add i32 %t6, 0
    store %t8, %t7
    %t9 = const u64 4
    call ferret_memcpy(%t5, %t6, %t9) : void
    %t10 = alloca i32
    %t11 = alloca Counter
    %t12 = const u64 4
    call ferret_memcpy(%t11, %t5, %t12) : void
    %t13 = call Counter_getValue(%t11) : i32
    store %t10, %t13
    %t14 = const i64 36
    %t15 = const i32 1
    %t16 = call ferret_array_new(%t14, %t15) : []Printable
    %t17 = load i32 %t10
    %t18 = alloca union {i8, i16, i32, i64, i128, i256, u8, u16, u32, u64, u128, u256, f32, f64, f128, f256, str, byte, bool}
    %t19 = ptr_add i32 %t18, 0
    %t20 = const i32 2
    store %t19, %t20
    %t21 = ptr_add i32 %t18, 4
    store %t21, %t17
    call ferret_array_append(%t16, %t18) : bool
    call io::Println(%t16) : void
    ret
}
