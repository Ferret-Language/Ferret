import "std/io";

fn test_multiple_panics(arr: []i32) {
    // Multiple array accesses on the same array
    let x := arr[0];    // array_get -> panic block
    let y := arr[1];    // array_get -> panic block
    arr[2] = 42;        // array_set -> panic block
    arr[3] = 43;        // array_set -> panic block
}

fn main() {
    let arr := [1, 2, 3, 4];
    test_multiple_panics(arr);
    io::Println("Done");
}