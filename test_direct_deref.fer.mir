module Ferret/test_direct_deref

fn main() -> void {
  block b1 entry:
    %t1 = const i64 36
    %t2 = const i32 1
    %t3 = call ferret_array_new(%t1, %t2) : []Printable
    %t4 = const str Test: Direct deref println
    %t5 = alloca union {i8, i16, i32, i64, i128, i256, u8, u16, u32, u64, u128, u256, f32, f64, f128, f256, str, byte, bool}
    %t6 = ptr_add i32 %t5, 0
    %t7 = const i32 16
    store %t6, %t7
    %t8 = ptr_add str %t5, 4
    store %t8, %t4
    call ferret_array_append(%t3, %t5) : bool
    call io::Println(%t3) : void
    %t9 = alloca i32
    %t10 = const i32 42
    store %t9, %t10
    %t11 = alloca &i32
    store %t11, %t9
    %t12 = const i64 36
    %t13 = const i32 1
    %t14 = call ferret_array_new(%t12, %t13) : []Printable
    %t15 = load &i32 %t11
    %t16 = load i32 %t15
    call ferret_array_append(%t14, %t16) : bool
    call io::Println(%t14) : void
    %t17 = const i64 36
    %t18 = const i32 1
    %t19 = call ferret_array_new(%t17, %t18) : []Printable
    %t20 = const str Done
    %t21 = alloca union {i8, i16, i32, i64, i128, i256, u8, u16, u32, u64, u128, u256, f32, f64, f128, f256, str, byte, bool}
    %t22 = ptr_add i32 %t21, 0
    %t23 = const i32 16
    store %t22, %t23
    %t24 = ptr_add str %t21, 4
    store %t24, %t20
    call ferret_array_append(%t19, %t21) : bool
    call io::Println(%t19) : void
    ret
}
