import "std/io";

fn mayFail() -> str ! i32 {
    return "boom"!;
}

fn main() {
    defer mayFail() catch err {
        if err == "x" {
            io::Println("branch 1");
        } else if err == "y" {
            for i in 0..3 {
                io::Println("loop in else-if", i);
            }
        } else if err == "boom" {
            if true {
                io::Println("deep nested if");
            } else {
                io::Println("deep nested else");
                // This must be rejected
                return;
            }
        } else {
            io::Println("final else");
        }
    };

    let arr := 0..8:-2;

    for v in arr {
        io::Println(v);
    }

    io::Println("end");
}
