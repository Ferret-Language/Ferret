import "std/mem"

fn is_non_null(p: ^void) -> bool {
    unsafe {
        let addr = p as usize
        return addr != 0
    }
}

fn assert_non_null(label: str, p: ^void) -> void {
    if !is_non_null(p) {
        panic label
    }
}

fn main() -> void {
    let sys = mem::System()
    let raw = sys.Alloc(16)
    assert_non_null("alloc failed", raw)

    unsafe {
        let typed = raw as ^u8
        let owner = mem::Adopt(typed)
        let raw_again = mem::Expose(owner)
        let erased = raw_again as ^void
        assert_non_null("expose returned null", erased)
        erased
    }

    print("ownership boundary smoke: PASS")
}
