import "std/io";
import "math";

type Color enum { Red, Green, Blue };

type Point struct {
    .X: i32,
    .Y: i32,
    .Shade: Color,
    .Data: [3]i32
};

fn divide(a: i32, b: i32) -> str ! i32 {
    if b == 0 {
        return "Division by zero"!;
    }
    return a / b;
}

fn main() {
    let nums := [1, 2, 3];
    append(&'nums, 4);
    nums[0] = nums[0] + 9;

    let nums2 := nums;
    nums2[1] = 77;

    io::Println("nums0 = " + nums[0]);
    io::Println("nums2_1 = " + nums2[1]);

    let total := 0;
    let i := 0;
    while i < len(nums) {
        total = total + nums[i];
        i += 1;
    }
    io::Println("sum = " + total);

    let fixed: [3]i32 = [10, 20, 30];
    fixed[1] = fixed[1] + 5;
    io::Println("fixed1 = " + fixed[1]);
    io::Println("fixed_len = " + len(fixed));

    let data: [3]i32 = [7, 8, 9];
    let p: Point = { .X = 1, .Y = 2, .Shade = Color::Green, .Data = data };
    p.X = p.X + 4;
    p.Data[1] = p.Data[0] + 5;

    if p.Shade == Color::Green {
        io::Println("shade ok");
    }
    io::Println(p.X);
    io::Println(p.Data[1]);
    io::Println(p.Shade as i32);

    let maybe: i32? = none;
    let some: i32? = 5;
    io::Println("opt1 = " + (maybe ?? 99));
    io::Println("opt2 = " + (some ?? 0));

    let ok := divide(10, 2) catch -1;
    io::Println("ok = " + ok);

    let fallback := divide(10, 0) catch e {
        io::Println("err = " + e);
    } -1;
    io::Println("fallback = " + fallback);

    let s: str = "Hello";
    let first: byte = s[0];
    let last: byte = s[-1];
    io::Println("first = " + (first as i32));
    io::Println("last = " + (last as i32));
    io::Println("slen = " + len(s));

    let a := 0;
    let b := 1;
    for _ in 2..=10 {
        let next := a + b;
        a = b;
        b = next;
    }
    io::Println("fib 10 = " + b);

    io::Println("flag = " + true);
    io::Println("pi = " + math::PI);
}
