import "std/io";

type Shape interface {
    area() -> f64,
};

type Point struct {
    .X: i32
};

fn (p: Point) area() -> f64 {
    return p.X ** 2;
}

fn make() -> Shape {
    let p: Point = { .X = 9 };
    return p as Shape;
}

fn returnRef() -> &Point {
    let p: Point = { .X = 9 };
    return &p;
}

fn main() {
    io::Println("Test start");
    let s := make();
    let p: Point = { .X = 9 };
    //let s: Shape = p;
    io::Println(s.area());
    io::Println("Shape area printed");
    let r := returnRef();
    io::Println(r.area());
    io::Println("Point ref area printed");
    io::Println("Test complete!");
}
