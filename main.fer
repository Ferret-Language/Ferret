import "std/math"

type point struct {
    X: i32
    Y: i32
    z: i32 = 0
}

fn point::incrby(&mut self, dx: i32, dy: i32) {
    if dx < 0 {
        panic "negative dx not allowed"
    }
    self.X = self.X + dx
    self.Y = self.Y + dy
}

fn sayHi() {
    print("Hi")
}

fn takeVal(v: &mut i32) {
    _ = v
}

fn give2() -> i32 {
    return 2
}

// test "gives 2" {

// }

type Number union {
    i32,
    f32
}

// A generic rule can be a union, interface or even primitive type alias.
// It just checks if the type arg can be used or not.
// very similar to how typechecker checks type compatibility of two bindings when assigning.

fn add<T: Number>(a: T, b: T) -> T {
    return a + b // This always returns T, not number
}

// fn add(a: Number, b: Number) -> Number {
//     return a + b // but this always returns the wraped type. Thats the difference
// }


