import "std/io";

fn main() {
    io::Println("=== Testing New Reference System with I/O ===");
    
    // Test 1: Basic value operations
    io::Println("\n--- Test 1: Basic Values ---");
    let x := 42;
    io::Print("x = ");
    io::Println(x);
    
    // Test 2: Mutable reference with modification
    io::Println("\n--- Test 2: Mutable Reference ---");
    let mut_val := 100;
    let ref_mut: &mut i32 = &mut mut_val;
    io::Print("Before: mut_val = ");
    io::Println(mut_val);
    io::Print("Before: *ref_mut = ");
    io::Println(*ref_mut);
    
    *ref_mut = 200;
    io::Print("After modification: mut_val = ");
    io::Println(mut_val);
    io::Print("After modification: *ref_mut = ");
    io::Println(*ref_mut);
    
    // Test 3: Immutable reference
    io::Println("\n--- Test 3: Immutable Reference ---");
    let imm_val := 777;
    let ref_imm: &i32 = &imm_val;
    io::Print("imm_val = ");
    io::Println(imm_val);
    io::Print("*ref_imm = ");
    io::Println(*ref_imm);
    
    // Test 4: Multiple derefs
    io::Println("\n--- Test 4: Multiple Dereferences ---");
    let a := 10;
    let b := 20;
    let c := 30;
    let r1: &i32 = &a;
    let r2: &i32 = &b;
    let r3: &i32 = &c;
    
    io::Print("*r1 = ");
    io::Println(*r1);
    io::Print("*r2 = ");
    io::Println(*r2);
    io::Print("*r3 = ");
    io::Println(*r3);
    
    // Test 5: Arithmetic with dereferenced values
    io::Println("\n--- Test 5: Arithmetic with Derefs ---");
    let val1 := 15;
    let val2 := 25;
    let ref1: &i32 = &val1;
    let ref2: &i32 = &val2;
    let sum := *ref1 + *ref2;
    io::Print("*ref1 + *ref2 = ");
    io::Println(sum);
    
    // Test 6: Modify through mutable ref multiple times
    io::Println("\n--- Test 6: Multiple Modifications ---");
    let counter := 0;
    let counter_ref: &mut i32 = &mut counter;
    io::Print("Initial counter = ");
    io::Println(*counter_ref);
    
    *counter_ref = *counter_ref + 1;
    io::Print("After +1: ");
    io::Println(*counter_ref);
    
    *counter_ref = *counter_ref + 10;
    io::Print("After +10: ");
    io::Println(*counter_ref);
    
    *counter_ref = *counter_ref * 2;
    io::Print("After *2: ");
    io::Println(*counter_ref);
    
    io::Println("\n=== All tests completed successfully! ===");
}
