import "std/io";

fn main() {
    let s := "hello";
    let i := 0;
    let len := 5;
    
    // Iterate through string, checking if next char exists before accessing it
    while i < len {
        io::Print(s[i]);
        
        // This is the key test: i+1 might be out of bounds,
        // but && should short-circuit so s[i+1] is not evaluated when i+1 >= len
        if i+1 < len && s[i+1] == 108 as byte {  // 108 is 'l'
            io::Print(" (next is 'l')");
        }
        
        io::Println("");
        i += 1;
    }
    
    io::Println("\nTest passed: no out-of-bounds panic!");
}
