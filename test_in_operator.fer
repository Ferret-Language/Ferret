import "std/io";

fn main() {
    let x := 5;
    
    // Test 'in' operator in if statement
    if x in 0..10 {
        io::Println("x is in range [0, 10)");
    }
    
    if x in 0..=10 {
        io::Println("x is in range [0, 10]");
    }
    
    if x in 10..20 {
        io::Println("x is in range [10, 20)");
    } else {
        io::Println("x is NOT in range [10, 20)");
    }
    
    // Test with constant expressions
    let y := 15;
    if y in 10..20 {
        io::Println("y is in range [10, 20)");
    }
    
    // Test dead code detection with constants
    if 5 in 0..10 {
        io::Println("This should print (5 is in 0..10)");
    } else {
        io::Println("DEAD CODE: 5 is always in 0..10");
    }
    
    if 15 in 0..10 {
        io::Println("DEAD CODE: 15 is never in 0..10");
    } else {
        io::Println("This should print (15 not in 0..10)");
    }
    
    // Test with variables
    let a := 7;
    let start := 5;
    let end := 10;
    
    if a in start..end {
        io::Println("a is in range [start, end)");
    }
}
