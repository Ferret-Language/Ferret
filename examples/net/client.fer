import "std/io";
import "std/net" as net;

fn main() {
    let conn := net::DialTcp("127.0.0.1:9090") catch err {
        io::Println("dial error:", err);
        return;
    };

    let written := net::WriteStr(conn, "ping") catch 0;

    let resp := net::Read(conn, 1024) catch err {
        io::Println("read error:", err);
        return;
    };

    io::Println("response bytes:", len(&resp));

    net::CloseConn(conn);
}
