import "std/io";
import "std/net" as net;

fn main() {
    let listener := net::ListenTcp("127.0.0.1:9090") catch err {
        io::Println("listen error:", err);
        return;
    };

    let conn := listener.Accept() catch err {
        io::Println("accept error:", err);
        return;
    };

    conn.SetReadTimeoutMs(5000) catch false;

    let data := conn.Read(1024) catch err {
        io::Println("read error:", err);
        return;
    };

    io::Println("received bytes:", len(&data));

    let written := conn.WriteStr("pong") catch 0;

    conn.Close();
    listener.Close();
}
