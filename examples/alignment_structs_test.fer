import "std/io";

type Inner struct {
    .b: u8,
    .pad: i16,
    .big: i64
};

type Mixed struct {
    .flag: bool,
    .count: i32,
    .ratio: f64,
    .small: u8,
    .arr: [3]u16,
    .inner: Inner
};

type Greeter interface {
    Greet() -> str
};

type Person struct {
    .name: str,
    .age: i64
};

fn (p: Person) Greet() -> str {
    return "hi " + p.name;
}

fn main() {
    io::Println("=== Alignment Test (structs + interface) ===");

    let a: Mixed = {
        .flag = true,
        .count = 42,
        .ratio = 3.14,
        .small = 7,
        .arr = [1, 2, 3],
        .inner = { .b = 1, .pad = 2, .big = 999 }
    };

    let b: Mixed = {
        .flag = false,
        .count = 7,
        .ratio = 2.71,
        .small = 9,
        .arr = [4, 5, 6],
        .inner = { .b = 2, .pad = 3, .big = 111 }
    };

    let m := { a => "A", b => "B" } as map[Mixed]str;
    io::Println("lookup:", m[a]);

    let p: Person = { .name = "Ada", .age = 36 };
    let g: Greeter = p;
    io::Println(g.Greet());
}
