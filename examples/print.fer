import "std/io";

fn Printf(fmt: str, args: ...io::Printable) {
    //io::Println(fmt, len(&args));
    let index := 0, args_index := 0;
    const chars := fmt as []char;
    while index < len(&chars) {
        if index+1 < len(&chars) && chars[index] == '{' && chars[index+1] == '}' {
            io::Print(args[args_index]);
            index += 2;
            args_index++;
        } 
        io::Print(chars[index]);
        index++;
    }
}

fn main() {
    Printf("Hello {} {} {}!\n", "world", 2, 3);
}