import "std/io";

fn Printf(fmt: str, args: ...Printable) {
    let count := 0, aCount := 0;
    let chars := fmt as []char;
    while count < len(&chars) {
        if count+1 < len(&chars) && chars[count] == '{' && chars[count+1] == '}' {
            io::Print(args[aCount]);
            count += 2;
            aCount++;
        }
        io::Print(chars[count]);
        count++;
    }
}

fn main() {
    Printf("Hello {} {}\n", "World");
}
