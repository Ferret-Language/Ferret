import "std/io";

fn test_heap_box() {
    let h := #123;

    let stack_before := addr(&h);
    let heap_before := addr_heap(&h);

    let moved: i32;
    moved = @h;

    let stack_after := addr(&moved);
    let heap_after := addr_heap(&moved);

    io::Println("box stack_changed", stack_before != stack_after);
    io::Println("box heap_same", heap_before != 0 && heap_before == heap_after);
}

fn test_array() {
    let arr: []i32 = [1, 2, 3];

    let stack_before := addr(&arr);
    let heap_before := addr_heap(&arr);

    let moved := @arr;

    let stack_after := addr(&moved);
    let heap_after := addr_heap(&moved);

    io::Println("arr stack_changed", stack_before != stack_after);
    io::Println("arr heap_same", heap_before != 0 && heap_before == heap_after);

    // copy test (deep copy should change heap backing)
    let a2: []i32 = [4, 5, 6];
    let heap_a2 := addr_heap(&a2);
    let copy := a2;
    let heap_copy := addr_heap(&copy);
    io::Println("arr copy_heap_diff", heap_a2 != 0 && heap_copy != 0 && heap_a2 != heap_copy);
}

fn test_map() {
    let m := { "a" => 1, "b" => 2 } as map[str]i32;

    let stack_before := addr(&m);
    let heap_before := addr_heap(&m);

    let moved := @m;

    let stack_after := addr(&moved);
    let heap_after := addr_heap(&moved);

    io::Println("map stack_changed", stack_before != stack_after);
    io::Println("map heap_same", heap_before != 0 && heap_before == heap_after);

    // copy test (deep copy should change heap backing)
    let m2 := { "x" => 9 } as map[str]i32;
    let heap_m2 := addr_heap(&m2);
    let copy := m2;
    let heap_copy := addr_heap(&copy);
    io::Println("map copy_heap_diff", heap_m2 != 0 && heap_copy != 0 && heap_m2 != heap_copy);
}

fn main() {
    io::Println("=== addr/addr_heap move verification ===");
    test_heap_box();
    test_array();
    test_map();
    io::Println("=== done ===");
}
