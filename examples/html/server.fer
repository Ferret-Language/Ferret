import "std/http";
import "std/io";
import "std/fs";


let app := http::Server();

app.Static("/", "examples/html/public");

app.Use(http::Log);

fn sendFileText(res: &mut http::Response, path: str, contentType: str) {
    let content := fs::ReadFile(path) catch err {
        res.Status(500);
        res.Send("Failed to read file: " + err);
        return;
    };
    res.Header("Content-Type", contentType);
    res.Send(content);
}

app.Get("/", fn(req: &http::Request, res: &mut http::Response) {
    sendFileText(res, "examples/html/index.html", "text/html; charset=utf-8");
});

app.Get("/api/data", fn(req: &http::Request, res: &mut http::Response) {
    res.Json("{\"status\":\"ok\",\"framework\":\"Ferret\",\"items\":[1,2,3,4]}");
});

app.Get("/plaintext", fn(req: &http::Request, res: &mut http::Response) {
    res.Header("Content-Type", "text/plain; charset=utf-8");
    res.Send("Hello from Ferret HTTP (plain text)");
});

fn main() {
    app.Listen(3000) catch err {
        io::Println("HTTP error:", err);
        return;
    };
    io::Println("Server running at http://127.0.0.1:3000");
}
