import "std/io";

// Test that ALL types can now be map keys with runtime content hashing

fn add(a: i32, b: i32) -> i32 { return a + b; }
fn mul(a: i32, b: i32) -> i32 { return a * b; }

fn main() {
    io::Println("=== Testing Universal Map Keys ===\n");
    
    // 1. Map as key (previously not allowed!)
    io::Println("1. Map as key:");
    let inner1 := { "x" => 1 } as map[str]i32;
    let inner2 := { "y" => 2 } as map[str]i32;
    
    let nested := {
        inner1 => "First map",
        inner2 => "Second map"
    } as map[map[str]i32]str;
    
    let lookup1 := { "x" => 1 } as map[str]i32;
    io::Println(nested[lookup1]);
    
    // 2. Slice as key (previously not allowed!)
    io::Println("\n2. Slice as key:");
    let slice1: []i32 = [1, 2, 3];
    let slice2: []i32 = [4, 5, 6];
    
    let slice_map := {
        slice1 => "First slice",
        slice2 => "Second slice"
    } as map[[]i32]str;
    
    io::Println(slice_map[slice1]);
    
    // 3. Function as key (previously not allowed!)
    io::Println("\n3. Function as key:");
    
    let func_map := {
        add => "Addition",
        mul => "Multiplication"
    } as map[fn(_: i32, _: i32) -> i32]str;
    
    io::Println(func_map[add]);
    
    io::Println("\n✅ All types work as map keys!");
}
