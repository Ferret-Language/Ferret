    // };
    // io::Println("LPOP ->", lpop);

    // IncrBy
    let ckey := "ferret:net:counter";
    let incr := client.IncrBy(ckey, 10) catch err {
        io::Println("INCRBY error:", err);
        return;
    };
    io::Println("INCRBY ->", incr);

