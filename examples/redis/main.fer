    //     io::Println("SADD error:", err);
    //     return;
    // };
    // io::Println("SADD ->", sadd);
    // let smembers := client.SMembers(skey) catch err {
    //     io::Println("SMEMBERS error:", err);
    //     return;
    // };
    // io::Println("SMEMBERS ->", smembers);

    // // List
    // let lkey := "ferret:net:list";
    // let lpush := client.LPush(lkey, "a", "b", "c") catch err {
    //     io::Println("LPUSH error:", err);
    //     return;
    // };
    // io::Println("LPUSH ->", lpush);
    // let lpop := client.LPop(lkey) catch err {
