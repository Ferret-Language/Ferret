type Conn struct {
    fd i32 = 0
}

fn (c *mut Conn) Conn(fd i32) {
    c.fd = fd
}

fn (c own *Conn) ~Conn() {
}

fn (c *Conn) IsOpen() i32 {
    return c.fd
}

fn Demo(ptr raw *i32, cond bool) i32 {
    let value = unsafe *ptr

    if cond {
        defer recover()
    } else {
        unsafe {
            lock value as guard {
                defer panic("boom")
            }
        }
    }

    unsafe panic("bad")
    return value
}
