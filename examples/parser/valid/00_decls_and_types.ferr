let mut GlobalCount: i32 = 0
const BuildMode = "debug"

type Point struct {
    x i32 = 0
    y i32 = 0
    static origin Point = .{}
}

type Shape interface {
    area() i32
}

type Color enum {
    red,
    green,
    blue,
}

type Token union {
    i32,
    string,
}

type IoErr error {
    denied,
    not_found,
}

fn BuildPoint() Point {
    let p: Point = .{ .x = 1, .y = 2 }
    return copy p
}
