fn Run(items [8]i32, limit i32) i32 {
    let mut sum: i32 = 0

    outer: for items |i, v| {
        inner: while v < limit {
            if i == 3 {
                break outer
            } else if v == 2 {
                break inner
            }

            sum = sum + (i as i32)
            sum = sum + v
            continue outer
        }
    }

    match sum {
    0 => {
        return 1
    }
    1 => {
        return 2
    }
    _ => {
        return sum
    }
    }
}
