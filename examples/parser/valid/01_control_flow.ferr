fn Run(items [8]i32, limit i32) i32 {
    let mut sum: i32 = 0

    outer: for items |i, v| {
        inner: while v < limit {
            if i == 3 {
                break outer
            } else if v == 2 {
                break inner
            }

            sum = sum + i
            sum = sum + v
            continue outer
        }
    }

    switch sum {
    case 0 {
        return 1
    }
    case 1 {
        return 2
    }
    }

    return sum
}
