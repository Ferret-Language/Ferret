fn Run(limit i32) i32 {
    let mut sum: i32 = 0

    outer: for let mut i: i32 = 0; i < limit; i = i + 1 {
        inner: while i < 10 {
            if i == 3 {
                break outer
            } else if i == 2 {
                break inner
            }

            sum = sum + i
            continue outer
        }
    }

    switch sum {
    case 0 {
        return 1
    }
    case 1 {
        return 2
    }
    }

    return sum
}
