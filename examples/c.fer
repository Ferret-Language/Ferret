import "std/io";

fn print_addrs(tag: str, x: &interface{}) {
    io::Println(tag, " stack =", addr(x), " heap =", heap_addr(x));
}

fn make() -> struct{ .X: i32, .Y: i32 } {
    let a := #{ .X = 10, .Y = 20 };
    print_addrs("make: a", &a);
    return @a;
}

type Printable union {
    i8,
    i16,
    i32,
    i64,
    i128,
    i256,
    u8,
    u16,
    u32,
    u64,
    u128,
    u256,
    f32,
    f64,
    f128,
    f256,
    str,
    byte,
    char,
    bool
};

fn myfn(vals: ...Printable) {
    io::Println("First item:", vals[0]);
}

fn main() {
    let a := #10;
    let b := #20;
    let c := #30;
    io::Println("------------ Function call ----------");
    print_addrs("a", &a);
    print_addrs("b", &b);
    print_addrs("c", &c);
    io::Println("------------ Direct ----------");
    io::Println("a", " stack =", self_addr(&a), " heap =", heap_addr(&a));
    io::Println("b", " stack =", self_addr(&b), " heap =", heap_addr(&b));
    io::Println("c", " stack =", self_addr(&c), " heap =", heap_addr(&c));
    c = a;
    io::Println("------------ Function call ----------");
    print_addrs("a", &a);
    print_addrs("b", &b);
    print_addrs("c", &c);
    io::Println("------------ Direct ----------");
    io::Println("a", " stack =", self_addr(&a), " heap =", heap_addr(&a));
    io::Println("b", " stack =", self_addr(&b), " heap =", heap_addr(&b));
    io::Println("c", " stack =", self_addr(&c), " heap =", heap_addr(&c));

    let x := make();
    print_addrs("x", &x);

    io::Println(x.X);

    let name := "small";
    
    let anothername := "small2";

    io::Println(name, self_addr(&name), addr(&name), heap_addr(&name));

    name = "hmm";

    io::Println(name, self_addr(&name), addr(&name), heap_addr(&name));

    name = "a very long text which should overflow the initial capacity";
    
    io::Println(name, self_addr(&name), addr(&name), heap_addr(&name));

    let z: i32 = 1;
    myfn(z);

}
