import "std/io";

fn print_addrs(tag: str, x: &i32) {
    io::Println(tag, " stack =", addr(x), " heap =", addr_heap(x));
}

fn make() -> i32 {
    let a := #10;
    print_addrs("make: a", &a);
    return @a;
}

fn main() {
    let a := #10;
    let b := #20;
    let c := #30;
    print_addrs("a", &a);
    print_addrs("b", &b);
    print_addrs("c", &c);
    io::Println("------------");
    io::Println("a", " stack =", addr(&a), " heap =", addr_heap(&a));
    io::Println("b", " stack =", addr(&b), " heap =", addr_heap(&b));
    io::Println("c", " stack =", addr(&c), " heap =", addr_heap(&c));
    io::Println("------------");
    c = a;
    print_addrs("a", &a);
    print_addrs("b", &b);
    print_addrs("c", &c);
    io::Println("------------");
    io::Println("a", " stack =", addr(&a), " heap =", addr_heap(&a));
    io::Println("b", " stack =", addr(&b), " heap =", addr_heap(&b));
    io::Println("c", " stack =", addr(&c), " heap =", addr_heap(&c));

    let x := make();
    print_addrs("x", &x);
}