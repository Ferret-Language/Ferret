import "std/io";

type Node struct {
    .Data: i32,
    .Next: i32?
};

type List struct {
    .Nodes: []Node,
    .Head: i32?
};

fn new_list() -> List {
    return { .Nodes = [], .Head = none };
}

fn push_front(list: &mut List, value: i32) {
    let idx := len(&list.Nodes);
    append(&mut list.Nodes, { .Data = value, .Next = list.Head });
    list.Head = idx;
}

fn print_list(list: &List) {
    let current := list.Head;
    while current != none {
        let idx := current;
        let node := list.Nodes[idx];
        io::Print(node.Data, " ");
        current = node.Next;
    }
    io::Println();
}

fn length(list: &List) -> i32 {
    let current := list.Head;
    let count := 0;
    while current != none {
        let idx := current;
        let node := list.Nodes[idx];
        count = count + 1;
        current = node.Next;
    }
    return count;
}

type A struct {
    .Data: i32,
    .Next: &mut A?,
};

fn make_bad_ref() -> i32 {
    let x: i32 = #123;
    return @x; // MUST FAIL: returning ref to local
}

type Wrap struct { .P: i32 };

fn make_wrap() -> Wrap {
    let x: i32 = #50;
    return { .P = @x }; // MUST FAIL
}

fn main() {
    let list := new_list();
    push_front(&mut list, 30);
    push_front(&mut list, 20);
    push_front(&mut list, 10);
    print_list(&list);


