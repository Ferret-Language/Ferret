module 00_control_flow
type Point struct {
    X i32 = 0
    Y i32 = 0
}

globals:
    let mut GlobalPoint: Point = .{ .X = 1, .Y = 2 }

fn main() i32 {
locals:
    p: Point [mut]
    _t1: i32 [temp]
    _t2: bool [temp]
    _t3: i32 [temp]
    _t4: i32 [temp]
    _t5: i32 [temp]
entry:
    p = copy GlobalPoint
    _t1 = field p 0
    _t2 = gt _t1 0
    branch _t2 -> bb1, bb2
bb1:
    _t3 = field p 0
    _t4 = add _t3 1
    store_field p 0 _t4
    jump bb3
bb2:
    jump bb3
bb3:
    _t5 = field p 0
    return _t5
}
