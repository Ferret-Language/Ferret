// Point data structure
type Point<T> struct {
    Value: T
}

type Circle<T> struct {
    Rad: T
}

fn Circle<T>::New(v: T) Self {
    return .{ .Rad = v }
}

fn Circle<T>::Draw(&self) {
    print("I am circle")
}

fn Point<T>::New(v: T) Self {
    return .{ .Value = v }
}

fn Point<T>::Draw(&self) {
    print("I am Point")
}

fn Point<T>::Incr(&mut self, cx: T) {
    self.Value += cx
}

fn Point<T>::Calc(&self) T {
    return self.Value
}

fn run2() {
    let mut p: Point<i32> = .{ .Value = 1 }
    p.Calc()
    p.Incr(1)
    let m = &mut p
    let r = &p
    //m
    r
    //return 0
}

type Shape interface {
    Draw(&self)
}

/* 
    This accepts any struct
    that implements shape
*/
fn drawShape<T: Shape>(s: T) {
    s.Draw()
}

type any interface{}

constraint numeric = union {
    i32,
    f32,
    u32
}

fn add<T>(a: T, b: T) T {
    return a + b
}

fn mul_unused<T>(a: T, b: T) T {
    return a * b
}

fn add_numbers<T: numeric>(a: T, b: T) T {
    return a + b
}

unsafe fn danger() {
    print("Danger!!!")
}

// program entry point
// all here
fn main() {
    // numeric data
    let mut a = 10
    let b : i32 = a
    // array size is inferred
    let arr : [_]i32 = [_]i32{23,46,67}
    let n = arr[1]
    let mut c = 5
    if c > 1 {
        print("c is more than 1")
    } else {
        print("c is less than 1")
    }

    // run2() catch |err| {

    // }
    // 
    jump:

    let p = .Point<i32>{ .Value = 2 }
    let cir = Circle<i32>::New(1)
    drawShape(p)
    drawShape(cir)

    let ax : any = p

    let num1 = 24
    let num2 = 53
    let res = add(num1, num2)
    print(res)

    print("--- loop start ---")
    while c > 0 {
        print(c)
        c--
        if c != 0 {
            print("------")
        }
    }
    print("--- loop end ---")

    print("###### For Loop ######")

    let mut sum = 0
    
    for arr | i, v | {
        print(i)
        print("-")
        print(v)
        sum += v
    }
    
    print("###### For Loop End ######")
    //c = 13
    print(a)
    print(b)
    print(n)
    print(len(arr))

    print(add_numbers(1, 2))
    print(add_numbers(1.4, 2.7))
    print(add_numbers(1 as u32, 22 as u32))

    unsafe danger()
    print(sum)
    print(os::Platform())
}
