

type Conn struct {}

fn run(mut c: *Conn) void {
    let m = &mut *c
    let r = &*c
    //m
    r
}

type Point struct {
    Value: i32 = 0
}

fn Point::Draw(&self) {
    print("I am Point")
}

fn Point::Incr(&mut self, cx: i32) {
    self.Value += cx
}

fn Point::Calc(&self) i32 {
    return self.Value
}

fn run2() {
    let mut p: Point = .{}
    p.Calc()
    p.Incr(1) // should only work if p is mutable
    let m = &mut p
    let r = &p
    //m
    r
    //return 0
}

type Shape interface {
    Draw(&self)
}

fn drawShape(s: Shape) {
    s.Draw()
}

type any interface{}

fn add<T>(a: T, b: T) T {
    return a + b
}

