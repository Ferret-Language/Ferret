import "std/string"

#[allow_unused]
fn usefn(val: i32, callback: fn(i32) ) {
    callback(val * 2)
}

type Point struct{
    x: i32 = 0,
    y: i32 = 0
}

fn Point::Incr(&mut self) {
    self.x++
    self.y++
}

fn Point::String(self) -> str {
    let mut buff = string::FromStr("Point{ ")
    buff.PushStr(to_str(self.x))
    buff.PushStr(", ")
    buff.PushStr(to_str(self.y))
    buff.PushStr(" }")

    return buff.AsStr()
}

fn main() {
    println("Hello")
    let name = "Fuad"
    usefn(24, (v: i32) => {
        println(v)
        //println(name)
    })

    (v: str) => {
        println(v)
    }(name)
    
    let mut p = Point{ .x = 24, .y = 13 }
    p.Incr()
    println(p)
    //somefn(name)
}
