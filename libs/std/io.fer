// Native IO module - implementations are in Go/C
// This file provides type declarations for type checking

// Printable union defines all types that can be printed
type Printable union {
    i8,
    i16,
    i32,
    i64,
    i128,
    i256,
    u8,
    u16,
    u32,
    u64,
    u128,
    u256,
    f32,
    f64,
    f128,
    f256,
    str,
    byte,
    char,
    bool,
    complex,
    complex64,
    complex256,
    complex512
};

// Streaming interfaces
type Reader interface {
    Read(maxBytes: i32) -> str ! []byte
};

type Writer interface {
    Write(buf: []byte) -> str ! i32
};

type Closer interface {
    Close()
};

type ReadWriter interface {
    Read(maxBytes: i32) -> str ! []byte,
    Write(buf: []byte) -> str ! i32
};

// @extern
fn Println(values: ...Printable);
// @extern
fn Print(values: ...Printable);
// @extern
fn ReadInt() -> str ! i32;
// @extern
fn ReadFloat() -> str ! f64;
// @extern
fn Read() -> str ! str;
// @extern
fn ReadUnsafe() -> str;

fn _appendBytes(dst: &mut []byte, src: []byte) -> bool {
    let i: i32 = 0;
    while i < len(&src) {
        if !append(dst, src[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn WriteString(w: Writer, s: str) -> str ! i32 {
    return w.Write(s as []byte) catch err {
        return err!;
    };
}

fn Copy(dst: Writer, src: Reader, bufSize: i32) -> str ! i64 {
    if bufSize <= 0 {
        return "bufSize must be > 0"!;
    }
    let total: i64 = 0;
    while true {
        let chunk := src.Read(bufSize) catch err {
            return err!;
        };
        let n := len(&chunk);
        if n == 0 {
            break;
        }
        let written := dst.Write(chunk) catch err {
            return err!;
        };
        total = total + (written as i64);
    }
    return total;
}

fn ReadAll(src: Reader, bufSize: i32) -> str ! []byte {
    if bufSize <= 0 {
        return "bufSize must be > 0"!;
    }
    let out: []byte = [] as []byte;
    while true {
        let chunk := src.Read(bufSize) catch err {
            return err!;
        };
        if len(&chunk) == 0 {
            break;
        }
        if !_appendBytes(&mut out, chunk) {
            return "out of memory"!;
        }
    }
    return out;
}

fn Printf(fmt: str, args: ...Printable) {
    let count := 0, aCount := 0;
    let chars := fmt as []char;
    while count < len(&chars) {
        if count+1 < len(&chars) && chars[count] == '{' && chars[count+1] == '}' {
            Print(args[aCount]);
            count += 2;
            aCount++;
            continue;
        }
        Print(chars[count]);
        count++;
    }
}
