// Native IO module - implementations are in Go/C
// This file provides type declarations for type checking

// Printable union defines all types that can be printed
type Printable union {
    i8,
    i16,
    i32,
    i64,
    i128,
    i256,
    u8,
    u16,
    u32,
    u64,
    u128,
    u256,
    f32,
    f64,
    f128,
    f256,
    str,
    byte,
    char,
    bool
};

// @extern
fn Println(values: ...Printable);
// @extern
fn Print(values: ...Printable);
// @extern
fn ReadInt() -> str ! i32;
// @extern
fn ReadFloat() -> str ! f64;
// @extern
fn Read() -> str ! str;
// @extern
fn ReadUnsafe() -> str;


fn Printf(fmt: str, vals: ...Printable) {
    let fmt_bytes := fmt as []byte;
    let i := 0;
    let val_index := 0;
    while i < len(&fmt_bytes) {
        if i+1 < len(&fmt_bytes) && fmt_bytes[i] == 123 as byte && fmt_bytes[i+1] == 125 as byte { // '{' == 123, '}' == 125
            Print(vals[val_index]);
            i += 2;
            val_index += 1;
            continue;
        }
        Print(fmt_bytes[i]);
        i++;
    }
}