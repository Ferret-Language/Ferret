//import "std/io";
// Global builtins (implicitly available in every module).
// Declarations only; implementations live in the runtime or compiler.

// Type is for internal use only. It helps the compiler to identify and group types
type Type interface{};

type SequenceView union{
  []Type,
  &[]Type
};

type SequenceRef &mut []Type;

type MapView<K: comparable, V> union {
  &map[K]V,
  map[K]V
};

type MapRef<K: comparable, V> &mut map[K]V;

// @extern
fn len(value: SequenceView) -> i32;
// @extern
fn append(source: SequenceRef, value: Type) -> bool;
// @extern
fn at(value: SequenceView, index: i32) -> ?Type;
// @extern
fn size_raw<K: comparable, V>(value: union { &map[K]V, map[K]V }) -> i32;
// @extern
fn get_raw<K: comparable, V>(value: union { &map[K]V, map[K]V }, key: &K) -> ?V;
// @extern
fn set_raw<K: comparable, V>(source: &mut map[K]V, key: &K, value: &V) -> bool;

fn size<K: comparable, V>(value: MapView<K, V>) -> i32 {
  return size_raw<K, V>(value as union { &map[K]V, map[K]V });
}

fn get<K: comparable, V>(value: MapView<K, V>, key: K) -> ?V {
  return get_raw<K, V>(value as union { &map[K]V, map[K]V }, &key);
}

fn set<K: comparable, V>(source: MapRef<K, V>, key: K, value: V) -> bool {
  return set_raw<K, V>(source as &mut map[K]V, &key, &value);
}


/**
- `addr(&x)`: address of the original storage location (the “place” of `x`).
- `self_addr(&x)`: address of the parameter slot inside the callee (the argument’s local storage).
- `heap_addr(&x)`: heap pointer if the value lives on heap; otherwise 0.
*/

// @extern
fn addr(value: &Type) -> u64;
// @extern
fn self_addr(value: &Type) -> u64;
// @extern
fn heap_addr(value: &Type) -> u64;
// @extern
fn panic(msg: str) -> void;
// @extern
fn recover() -> ?str;
// @extern
fn real(value: &Type) -> f256;
// @extern
fn imag(value: &Type) -> f256;

