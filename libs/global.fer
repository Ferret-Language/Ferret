// Global builtins (implicitly available in every module).
// These are declarations only; implementations are compiler intrinsics.

// @extern
// Note: len borrows read-only (&) and requires an explicit reference.
fn len(value: union{ &interface{}, interface{} }) -> i32;
// @extern
// Note: append borrows mutably (&mut) and requires an addressable target.
fn append(values: &mut []interface {}, value: interface {}) -> bool;
// @extern
fn panic(msg: str) -> void;
