module struct_sample_test
type Point struct {
    X i32 = 1
    Y i32 = 2
    static Counter i32 = 0
}
type Circle struct {
    Rad f32
}
type Shape interface {
    Show() void
}

const Point__Counter: i32 = 0

fn (_ *local:struct_sample_test::Circle) Show() void {
    io::Println("I am a circle")
}

fn (_ *mut local:struct_sample_test::Point) Point() void {
    io::Println("ctor")
    Point::Counter = Point::Counter + 1
}

fn (_ *own local:struct_sample_test::Point) ~Point() void {
    io::Println("dtor")
}

fn (_ *local:struct_sample_test::Point) Show() void {
    io::Println("I am a point")
}

fn who(s local:struct_sample_test::Shape) void {
    s.Show()
}

fn main() i32 {
    let mut p: local:struct_sample_test::Point = .{ .X = 1, .Y = 2 }
    defer p.~Point()
    print(p.X)
    print(p.Y)
    print(Point::Counter)
    let p2: local:struct_sample_test::Point = .{ .X = 1, .Y = 2 }
    defer p2.~Point()
    print(p2.X)
    print(p2.Y)
    print(Point::Counter)
    let mut maybe: ?i32 = none
    maybe = 21
    maybe = 66
    maybe = none
    let p3: local:struct_sample_test::Point = .{ .X = 1, .Y = 2 } as local:struct_sample_test::Point
    defer p3.~Point()
    let c1: local:struct_sample_test::Circle = .{ .Rad = 2.3 } as local:struct_sample_test::Circle
    who(p3)
    who(c1)
    return 0
}
