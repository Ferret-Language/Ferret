// ctfe.ferr
// Incremental CTFE smoke file.
// Keep this file runnable; add new checks as features land.
//
// Negative examples (uncomment to verify diagnostics):
//
// #[extern("clock")]
// fn clock() i32;
//
// fn badComptimeArg() i32 {
//     return passComptimeArg(clock())
// }
//
// fn badComptimeExpr() i32 {
//     let x = 1
//     return comptime x
// }
//
// fn badStaticAssert() void {
//     comptime assert(false, "static assert failed")
// }
//
// fn badCompileError() void {
//     comptime {
//         compile_error("forced failure")
//     }
// }
//
fn tuplePick() i32 {
    let p: (i32, i32) = .{1, 2}
    return p[0] + p[1]
}

fn mixedTupleCheck() bool {
    let p: (i32, bool, str) = .{7, true, "ok"}
    return p[0] == 7 && p[1] && p[2] == "ok"
}

type Counter struct {
    Value: i32
}

fn Counter::Inc(&mut self, by: i32) i32 {
    self.Value = self.Value + by
    return self.Value
}

fn sumTo(n: i32) i32 {
    let mut i = 0
    let mut sum = 0
    while i <= n {
        sum = sum + i
        i = i + 1
    }
    return sum
}

fn buildCounterValue() i32 {
    let mut c: Counter = .{ .Value = 1 }
    let n = c.Inc(2)
    return c.Value + n
}

fn passComptimeArg(comptime x: i32) i32 {
    return x
}

fn assert(comptime cond: bool, comptime msg: str) {
    if !cond {
        panic msg
    }
}

fn static_assert(comptime cond: bool, comptime msg: str) {
    comptime assert(cond, msg)
}


fn edgeSum() i32 {
    let arr: [3]i32 = [3]i32{1, 2, 3}
    return arr[0] + arr[2]
}

fn sumWithFor() i32 {
    let arr: [4]i32 = [4]i32{1, 2, 3, 4}
    let mut sum = 0
    for arr |value| {
        sum = sum + value
    }
    return sum
}

fn require(name: str, cond: bool) void {
    if !cond {
        print("FAIL:")
        print(name)
        panic "ctfe check failed"
    }
    print("ok:")
    print(name)
}

fn main() {
    let a = comptime 1 + 2
    let b = comptime sumTo(4)              // 10
    let c = comptime buildCounterValue()   // 6
    const K = 9
    let d = passComptimeArg(K)
    let e = comptime edgeSum()             // 4
    let f = comptime sumWithFor()          // 10
    let g = comptime tuplePick()           // 3
    let h = comptime mixedTupleCheck()     // true

    static_assert(a != b, "math broke")

    comptime static_assert(1 == 2, "error")
    comptime assert(1 == 6, "error")

    require("comptime literal expression", a == 3)
    require("comptime function with while", b == 10)
    require("comptime method call", c == 6)
    require("comptime parameter (const)", d == 9)
    require("comptime array index", e == 4)
    require("comptime for loop", f == 10)
    require("comptime tuple index", g == 3)
    require("comptime mixed tuple index", h)

    print("ctfe smoke: PASS")
}
