module Ferret/example_panic

fn test_multiple_panics(arr: []i32) -> void {
  block b1 entry:
    %t2 = alloca i32
    %t3 = const i32 0
    %t4 = call ferret_array_len(%t1) : i32
    %t5 = const i32 0
    %t6 = < i32 %t3, %t5
    br_if %t6, b2, b3
  block b2 index.neg:
    %t7 = + i32 %t4, %t3
    br b4
  block b3 index.pos:
    br b4
  block b4 index.merge:
    %t8 = phi i32 [b2: %t7, b3: %t3]
    %t9 = < i32 %t8, %t5
    %t10 = >= i32 %t8, %t4
    %t11 = || bool %t9, %t10
    br_if %t11, b6, b5
  block b5 index.ok:
    %t13 = call ferret_array_get(%t1, %t8) : &i32
    %t14 = load i32 %t13
    store %t2, %t14
    %t15 = alloca i32
    %t16 = const i32 1
    %t17 = call ferret_array_len(%t1) : i32
    %t18 = const i32 0
    %t19 = < i32 %t16, %t18
    br_if %t19, b7, b8
  block b6 index.oob:
    %t12 = const str index out of bounds
    call ferret_global_panic(%t12) : void
    unreachable
  block b7 index.neg:
    %t20 = + i32 %t17, %t16
    br b9
  block b8 index.pos:
    br b9
  block b9 index.merge:
    %t21 = phi i32 [b7: %t20, b8: %t16]
    %t22 = < i32 %t21, %t18
    %t23 = >= i32 %t21, %t17
    %t24 = || bool %t22, %t23
    br_if %t24, b11, b10
  block b10 index.ok:
    %t26 = call ferret_array_get(%t1, %t21) : &i32
    %t27 = load i32 %t26
    store %t15, %t27
    %t28 = const i32 2
    %t29 = call ferret_array_len(%t1) : i32
    %t30 = const i32 0
    %t31 = < i32 %t28, %t30
    br_if %t31, b12, b13
  block b11 index.oob:
    %t25 = const str index out of bounds
    call ferret_global_panic(%t25) : void
    unreachable
  block b12 index.neg:
    %t32 = + i32 %t29, %t28
    br b14
  block b13 index.pos:
    br b14
  block b14 index.merge:
    %t33 = phi i32 [b12: %t32, b13: %t28]
    %t34 = < i32 %t33, %t30
    %t35 = >= i32 %t33, %t29
    %t36 = || bool %t34, %t35
    br_if %t36, b16, b15
  block b15 index.ok:
    %t38 = const i32 42
    array_set %t1, %t33, %t38
    %t39 = const i32 3
    %t40 = call ferret_array_len(%t1) : i32
    %t41 = const i32 0
    %t42 = < i32 %t39, %t41
    br_if %t42, b17, b18
  block b16 index.oob:
    %t37 = const str index out of bounds
    call ferret_global_panic(%t37) : void
    unreachable
  block b17 index.neg:
    %t43 = + i32 %t40, %t39
    br b19
  block b18 index.pos:
    br b19
  block b19 index.merge:
    %t44 = phi i32 [b17: %t43, b18: %t39]
    %t45 = < i32 %t44, %t41
    %t46 = >= i32 %t44, %t40
    %t47 = || bool %t45, %t46
    br_if %t47, b21, b20
  block b20 index.ok:
    %t49 = const i32 43
    array_set %t1, %t44, %t49
    ret
  block b21 index.oob:
    %t48 = const str index out of bounds
    call ferret_global_panic(%t48) : void
    unreachable
}

fn main() -> void {
  block b22 entry:
    %t50 = alloca []i32
    %t51 = const i64 4
    %t52 = const i32 4
    %t53 = call ferret_array_new(%t51, %t52) : []i32
    %t54 = const i32 1
    %t55 = alloca i32
    store %t55, %t54
    call ferret_array_append(%t53, %t55) : bool
    %t56 = const i32 2
    %t57 = alloca i32
    store %t57, %t56
    call ferret_array_append(%t53, %t57) : bool
    %t58 = const i32 3
    %t59 = alloca i32
    store %t59, %t58
    call ferret_array_append(%t53, %t59) : bool
    %t60 = const i32 4
    %t61 = alloca i32
    store %t61, %t60
    call ferret_array_append(%t53, %t61) : bool
    store %t50, %t53
    %t62 = load []i32 %t50
    %t63 = call ferret_array_clone(%t62) : []i32
    call test_multiple_panics(%t63) : void
    %t64 = const i64 36
    %t65 = const i32 1
    %t66 = call ferret_array_new(%t64, %t65) : []Printable
    %t67 = const str Done
    %t68 = alloca union {i8, i16, i32, i64, i128, i256, u8, u16, u32, u64, u128, u256, f32, f64, f128, f256, str, byte, bool}
    %t69 = ptr_add i32 %t68, 0
    %t70 = const i32 16
    store %t69, %t70
    %t71 = ptr_add str %t68, 4
    store %t71, %t67
    call ferret_array_append(%t66, %t68) : bool
    call io::Println(%t66) : void
    ret
}
