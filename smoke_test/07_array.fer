import "std/io";

type Array union {
    &[]i32,
    []i32
};

fn test(values: Array) {
    if values is &[]i32 {
        io::Print("Printing array ref: ");
        for value in *values {
            io::Print(value, " ");
        }
    } else {
        io::Print("Printing array value: ");
        for value in values {
            io::Print(value, " ");
        }
    }
    io::Println();
}

fn main() {
    let nums := [1, 2, 3];
    append(&mut nums, 4);
    io::Println(len(&nums));
    io::Println(nums[2]);
    
    let arr := [1,2,3];
    
    test(&arr);
    test([1,2,4]);
}
