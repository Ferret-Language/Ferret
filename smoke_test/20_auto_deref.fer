import "std/io";

type Point struct {
    .X: i32,
    .Y: i32
};

fn main() {
    let p := { .X = 1, .Y = 2 } as Point;
    let pr := &p;

    io::Println(pr.X);
    io::Println(pr.Y);

    let arr := [10, 20, 30];
    let arr_ref := &mut arr;
    io::Println(arr_ref[1]);
    arr_ref[0] = 99;
    io::Println(arr[0]);

    let m := { "a" => 1, "b" => 2 } as map[str]i32;
    let m_ref := &mut m;
    io::Println(m_ref["b"]);
    m_ref["a"] = 7;
    io::Println(m["a"]);
}
