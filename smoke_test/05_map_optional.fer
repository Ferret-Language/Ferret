import "std/io";

fn main() {
    let scores := {
        "alpha" => 1,
        "beta" => 2
    } as map[str]i32;

    io::Println(scores["alpha"]);
    //io::Println(scores["gamma"]); // fail
    let maybe : ?i32 = 4;
    io::Println(maybe ?? -1);


    scores["gamma"] = 3;
    io::Println(scores["gamma"]);
}
