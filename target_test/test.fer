import "std/io";

type Point struct { .X: i32, .Y: i32 };

fn make() -> [3]i32 {
    return [1, 2, 3];
}

fn sum(a: i128, b: i128) -> i128 {
    return a + b;
}

fn main() {
    let p := { .X = 1, .Y = 2 };
    let x := p.X;
    
    io::Println(p.Y);
    
    p.Y = 3;
    
    io::Println(p.Y);

    let a := make();

    io::Println(len(&a));

    let m: i128 = 242;
    let n: i128 = 10;

    io::Println(sum(m, n));
}