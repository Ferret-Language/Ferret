fn is_non_null(p: ^void) -> bool {
    unsafe {
        let addr = p as usize
        return addr != 0
    }
}

fn assert_non_null(label: str, p: ^void) -> void {
    if !is_non_null(p) {
        panic label
    }
}

fn main() -> void {
    let p1 = malloc(64)
    assert_non_null("malloc failed", p1)

    let p2 = calloc(1, 64)
    assert_non_null("calloc failed", p2)

    let p3 = realloc(p1, 128)
    assert_non_null("realloc failed", p3)

    free(p2)
    free(p3)
    print("allocator ffi smoke: PASS")
}
