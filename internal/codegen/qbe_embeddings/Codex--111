		mirMod:           mirMod,
		layout:           mir.NewDataLayout(pointerSize, sliceHeaderWords),
		valueTypes:       make(map[mir.ValueID]types.SemType),
		stringLits:       make(map[string]string),
		enumTables:       make(map[string]string),
		enumCounts:       make(map[string]int),
