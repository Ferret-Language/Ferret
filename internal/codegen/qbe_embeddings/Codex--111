		for globalName, typ := range g.mirMod.TypeDescriptors {
			if !g.emittedTypeDescs[globalName] {
				g.emitTypeDescriptor(globalName, typ)
				g.emittedTypeDescs[globalName] = true
				anyNew = true
			}
