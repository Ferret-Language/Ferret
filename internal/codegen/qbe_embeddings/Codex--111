import "std/net" as net;

// Minimal Redis client over RESP (pure Ferret).

type ReplyKind enum {
    Simple,
    Bulk,
    Integer,
    Array,
    Nil,
    Error
};

type Reply struct {
    .Kind: ReplyKind,
    .Text: str,
    .Number: i64,
    .Items: []Reply
};

type Client struct {
    .conn: net::TcpConn,
    .buf: []byte
};

fn Connect(addr: str) -> str ! Client {
