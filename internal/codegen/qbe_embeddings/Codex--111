		unionAlign := max(okAlign, errAlign)
		unionSize := alignTo(max(okSize, errSize), unionAlign)
		return alignTo(unionSize+1, max(unionAlign, 1))
	case *types.StructType:
		layout := d.StructLayout(tt)
		return layout.Size
	default:
		return tt.Size()
	}
}

