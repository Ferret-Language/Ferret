fn parseInt64(data: []byte, start: i32, end: i32) -> i64 {
    let i: i32 = start;
    if i >= end {
        return 0;
    }
    let sign: i64 = 1;
    if data[i] == 45 { // '-'
        sign = -1;
        i += 1;
    }
    let n: i64 = 0;
    while i < end {
        n = n * 10 + ((data[i] as i64) - 48);
        i += 1;
    }
    return n * sign;
}

fn parseInt32(data: []byte, start: i32, end: i32) -> i32 {
    let i: i32 = start;
    if i >= end {
        return 0;
    }
    let sign: i32 = 1;
    if data[i] == 45 { // '-'
        sign = -1;
        i += 1;
    }
    let n: i32 = 0;
    while i < end {
        n = n * 10 + ((data[i] as i32) - 48);
        i += 1;
    }
    return n * sign;
}

fn bytesToStr(data: []byte, start: i32, length: i32) -> str {
