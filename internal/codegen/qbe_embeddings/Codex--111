func (g *Generator) emitBlock(block *mir.Block, mainReturnsInt bool) {
	if block == nil {
		return
	}

	g.buf.WriteString(g.blockName(block.ID))
	g.buf.WriteString("\n")

	for _, instr := range block.Instrs {
		if _, ok := instr.(*mir.Phi); ok {
			g.emitInstr(instr)
