	g.buf.WriteString(" $" + fnName + "(")

	startIdx := 0
	hasParams := len(fn.Params) > 0
	if hasParams && fn.Params[0].IsEnv {
		g.buf.WriteString("env " + g.valueName(fn.Params[0].ID))
		g.valueTypes[fn.Params[0].ID] = fn.Params[0].Type
