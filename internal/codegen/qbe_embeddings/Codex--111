fn concatBytes(a: []byte, b: []byte) -> []byte {
    let out: []byte = [];
    let i: i32 = 0;
    while i < len(&a) {
        append(&mut out, a[i]);
        i += 1;
    }
    let j: i32 = 0;
    while j < len(&b) {
        append(&mut out, b[j]);
        j += 1;
    }
    return out;
}

fn dropBytes(buf: []byte, n: i32) -> []byte {
    if n <= 0 {
        return buf;
    }
    let out: []byte = [];
    let i: i32 = n;
    let total := len(&buf);
    while i < total {
        append(&mut out, buf[i]);
        i += 1;
    }
    return out;
}

fn (c: &mut Client) readReply() -> str ! Reply {
    while true {
        let res := parseAt(c.buf, 0);
        if res.Err != "" {
            return res.Err!;
        }
        if res.Done {
            c.buf = dropBytes(c.buf, res.Consumed);
            return res.Reply;
        }

