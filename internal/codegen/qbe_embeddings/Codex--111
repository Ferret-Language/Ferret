static uint32_t utf8_decode(const uint8_t** ptr) {
    const uint8_t* p = *ptr;
    uint32_t codepoint;
    
    if ((*p & 0x80) == 0) {
        // 1-byte sequence (0xxxxxxx): ASCII
        codepoint = *p;
        *ptr += 1;
    } else if ((*p & 0xE0) == 0xC0) {
        // 2-byte sequence (110xxxxx 10xxxxxx)
        codepoint = ((*p & 0x1F) << 6) | (*(p+1) & 0x3F);
