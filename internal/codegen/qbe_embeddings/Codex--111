    if data[i] == 45 { // '-'
        sign = -1;
        i += 1;
    }
    let n: i32 = 0;
    while i < end {
        n = n * 10 + ((data[i] as i32) - 48);
        i += 1;
    }
    return n * sign;
}

fn bytesToStr(data: []byte, start: i32, length: i32) -> str {
    let out := "";
    let i: i32 = 0;
    while i < length {
        out = out + data[start + i];
        i += 1;
    }
    return out;
}

fn concatBytes(a: []byte, b: []byte) -> []byte {
    let out: []byte = [];
    let i: i32 = 0;
    while i < len(&a) {
        append(&mut out, a[i]);
        i += 1;
    }
    let j: i32 = 0;
    while j < len(&b) {
        append(&mut out, b[j]);
        j += 1;
    }
    return out;
}

fn (c: &mut Client) readMore() -> str ! bool {
    let chunk := net::Read(c.conn, 4096) catch err {
        return err!;
    };
    if len(&chunk) == 0 {
        return "connection closed"!;
    }
    c.buf = concatBytes(c.buf, chunk);
    return true;
}

fn (c: &mut Client) readReplyOpt() -> str ! str? {
    while true {
        if len(&c.buf) == 0 {
            let ok := c.readMore() catch err {
                return err!;
            };
            if !ok {
                return "connection closed"!;
            }
        }

        let prefix := c.buf[0];
        let lineEnd := findCrlf(c.buf, 1);
        if lineEnd < 0 {
            let ok := c.readMore() catch err {
                return err!;
            };
            if !ok {
                return "connection closed"!;
            }
            continue;
        }

        let lineStart := 1;
        let lineLen := lineEnd - lineStart;

        if prefix == 43 { // '+'
            let text := bytesToStr(c.buf, lineStart, lineLen);
            c.buf = dropBytes(c.buf, lineEnd + 2);
            return text;
        }
        if prefix == 45 { // '-'
            let text := bytesToStr(c.buf, lineStart, lineLen);
            c.buf = dropBytes(c.buf, lineEnd + 2);
            return text!;
        }
        if prefix == 58 { // ':'
            let val := parseInt64(c.buf, lineStart, lineEnd);
            c.buf = dropBytes(c.buf, lineEnd + 2);
            return "" + val;
        }
        if prefix == 36 { // '$'
            let bulkLen := parseInt32(c.buf, lineStart, lineEnd);
            if bulkLen < 0 {
                c.buf = dropBytes(c.buf, lineEnd + 2);
                return none;
            }
            let bodyStart := lineEnd + 2;
            let endNeeded := bodyStart + bulkLen + 2;
            if endNeeded > len(&c.buf) {
                let ok := c.readMore() catch err {
                    return err!;
                };
                if !ok {
                    return "connection closed"!;
                }
                continue;
            }
            let text := bytesToStr(c.buf, bodyStart, bulkLen);
            c.buf = dropBytes(c.buf, endNeeded);
            return text;
        }
        if prefix == 42 { // '*'
            return "array replies not supported yet"!;
        }

        return "invalid resp"!;
    }
}

fn (c: &mut Client) readReplyInt() -> str ! i64 {
    while true {
        if len(&c.buf) == 0 {
            let ok := c.readMore() catch err {
                return err!;
            };
            if !ok {
                return "connection closed"!;
            }
        }

        let prefix := c.buf[0];
        let lineEnd := findCrlf(c.buf, 1);
        if lineEnd < 0 {
            let ok := c.readMore() catch err {
                return err!;
            };
            if !ok {
                return "connection closed"!;
            }
            continue;
        }

        let lineStart := 1;
        if prefix == 45 { // '-'
            let text := bytesToStr(c.buf, lineStart, lineEnd - lineStart);
            c.buf = dropBytes(c.buf, lineEnd + 2);
            return text!;
        }
        if prefix != 58 { // ':'
            return "unexpected reply type"!;
        }
        let val := parseInt64(c.buf, lineStart, lineEnd);
        c.buf = dropBytes(c.buf, lineEnd + 2);
        return val;
    }
}

fn dropBytes(buf: []byte, n: i32) -> []byte {
    if n <= 0 {
        return buf;
    }
    let out: []byte = [];
    let i: i32 = n;
    let total := len(&buf);
    while i < total {
        append(&mut out, buf[i]);
        i += 1;
    }
    return out;
}

fn (c: &mut Client) commandArgs(args: []str) -> str ! bool {
    let cmd := buildCommand(args);
    let written := net::WriteStr(c.conn, cmd) catch err {
        return err!;
    };
    return true;
}

fn (c: &mut Client) CommandArgs(args: []str) -> str ! str {
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    let val := c.readReplyOpt() catch err {
        return err!;
    };
    return val ?? "";
}

fn (c: &mut Client) CommandStr(args: ...str) -> str ! str {
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    let val := c.readReplyOpt() catch err {
        return err!;
    };
    return val ?? "";
}

fn (c: &mut Client) CommandInt(args: ...str) -> str ! i64 {
    let ok := c.commandArgs(args) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyInt() catch err {
        return err!;
    };
}

fn (c: &mut Client) Ping() -> str ! str {
    return c.CommandStr("PING") catch err {
        return err!;
    };
}

fn (c: &mut Client) Get(key: str) -> str ! str? {
    let ok := c.commandArgs(["GET", key]) catch err {
        return err!;
    };
    if !ok {
        return "send failed"!;
    }
    return c.readReplyOpt() catch err {
        return err!;
    };
}

fn (c: &mut Client) Set(key: str, value: str) -> str ! bool {
    let rep := c.CommandStr("SET", key, value) catch err {
        return err!;
    };
    return rep == "OK";
}

fn (c: &mut Client) Del(key: str) -> str ! i64 {
    return c.CommandInt("DEL", key) catch err {
        return err!;
    };
}

