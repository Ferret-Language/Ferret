	for _, block := range fn.Blocks {
		for _, instr := range block.Instrs {
			alloc, ok := instr.(*mir.Alloca)
			if !ok || alloc == nil {
				continue
			}
			g.hoistedAllocas = append(g.hoistedAllocas, alloc)
			g.hoistedAllocaIDs[alloc.Result] = struct{}{}
		}
