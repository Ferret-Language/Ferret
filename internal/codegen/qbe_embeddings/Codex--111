        out = out + data[start + i];
        i += 1;
    }
    return out;
}

fn parseResp(data: []byte) -> str ! str {
    let n := len(&data);
    if n <= 0 {
        return "empty response"!;
    }

    let prefix := data[0];
    let lineEnd := findCrlf(data, 1);
    if lineEnd < 0 {
        return "invalid response"!;
    }

    let lineStart: i32 = 1;
    let lineLen: i32 = lineEnd - lineStart;

    if prefix == 43 { // '+'
        return bytesToStr(data, lineStart, lineLen);
    }
    if prefix == 45 { // '-'
        return "ERR: " + bytesToStr(data, lineStart, lineLen);
    }
    if prefix == 58 { // ':'
        let val := parseInt(data, lineStart, lineEnd);
        return "" + val;
    }
    if prefix == 36 { // '$'
        let bulkLen := parseInt(data, lineStart, lineEnd);
        if bulkLen < 0 {
            return "(nil)";
        }
        let bodyStart := lineEnd + 2;
        if bodyStart + bulkLen > n {
            return "invalid bulk response"!;
        }
        return bytesToStr(data, bodyStart, bulkLen);
    }

    return "unknown response"!;
}

fn readResp(conn: net::TcpConn) -> str ! str {
    let data := net::Read(conn, 4096) catch err {
        return err!;
    };
    return parseResp(data) catch err {
        return err!;
    };
}

