import "std/net" as net;

// Minimal Redis client over RESP (pure Ferret).

type ReplyKind enum {
    Simple,
    Bulk,
    Integer,
    Nil,
    Error
};

type Reply struct {
    .Kind: ReplyKind,
    .Text: str,
    .Number: i64
};

type Client struct {
    .conn: net::TcpConn,
    .buf: []byte
};

fn Connect(addr: str) -> str ! Client {
    let conn := net::DialTcp(addr) catch err {
        return err!;
    };
    return { .conn = conn, .buf = [] };
}

fn (c: &mut Client) Close() {
    net::CloseConn(c.conn);
}

fn strLen(s: str) -> i32 {
    let bytes := s as []byte;
    return len(&bytes);
}

fn respBulk(s: str) -> str {
    return "$" + strLen(s) + "\r\n" + s + "\r\n";
}

fn buildCommand(args: []str) -> str {
    let out := "*" + len(&args) + "\r\n";
    let i: i32 = 0;
    while i < len(&args) {
        out = out + respBulk(args[i]);
        i += 1;
    }
    return out;
}

fn findCrlf(data: []byte, start: i32) -> i32 {
    let i: i32 = start;
    let n := len(&data);
    while i + 1 < n {
        if data[i] == 13 && data[i + 1] == 10 {
            return i;
        }
        i += 1;
    }
    return -1;
}

fn parseInt64(data: []byte, start: i32, end: i32) -> i64 {
    let i: i32 = start;
    if i >= end {
        return 0;
    }
    let sign: i64 = 1;
    if data[i] == 45 { // '-'
        sign = -1;
        i += 1;
    }
    let n: i64 = 0;
    while i < end {
        n = n * 10 + ((data[i] as i64) - 48);
        i += 1;
    }
    return n * sign;
}

fn parseInt32(data: []byte, start: i32, end: i32) -> i32 {
    let i: i32 = start;
    if i >= end {
        return 0;
    }
    let sign: i32 = 1;
    if data[i] == 45 { // '-'
        sign = -1;
        i += 1;
    }
    let n: i32 = 0;
    while i < end {
        n = n * 10 + ((data[i] as i32) - 48);
        i += 1;
    }
    return n * sign;
}

fn bytesToStr(data: []byte, start: i32, length: i32) -> str {
    let out := "";
    let i: i32 = 0;
    while i < length {
        out = out + data[start + i];
        i += 1;
    }
    return out;
}

type ParseResult struct {
    .Done: bool,
    .Consumed: i32,
    .Reply: Reply,
    .Err: str
};

fn reply(kind: ReplyKind, text: str, number: i64) -> Reply {
    return { .Kind = kind, .Text = text, .Number = number };
}

fn parseAt(data: []byte, start: i32) -> ParseResult {
    let n := len(&data);
    let empty := reply(ReplyKind::Nil, "", 0);

    if start >= n {
        return { .Done = false, .Consumed = 0, .Reply = empty, .Err = "" };
    }

    let prefix := data[start];
    let lineEnd := findCrlf(data, start + 1);
    if lineEnd < 0 {
        return { .Done = false, .Consumed = 0, .Reply = empty, .Err = "" };
    }

    let lineStart := start + 1;
    let lineLen := lineEnd - lineStart;

    if prefix == 43 { // '+' simple
        let text := bytesToStr(data, lineStart, lineLen);
        let rep := reply(ReplyKind::Simple, text, 0);
        return { .Done = true, .Consumed = (lineEnd + 2 - start), .Reply = rep, .Err = "" };
    }
    if prefix == 45 { // '-' error
        let text := bytesToStr(data, lineStart, lineLen);
        let rep := reply(ReplyKind::Error, text, 0);
        return { .Done = true, .Consumed = (lineEnd + 2 - start), .Reply = rep, .Err = "" };
    }
    if prefix == 58 { // ':' integer
        let val := parseInt64(data, lineStart, lineEnd);
        let rep := reply(ReplyKind::Integer, "", val);
        return { .Done = true, .Consumed = (lineEnd + 2 - start), .Reply = rep, .Err = "" };
    }
    if prefix == 36 { // '$' bulk
        let bulkLen := parseInt32(data, lineStart, lineEnd);
        if bulkLen < 0 {
            let rep := reply(ReplyKind::Nil, "", 0);
            return { .Done = true, .Consumed = (lineEnd + 2 - start), .Reply = rep, .Err = "" };
        }
        let bodyStart := lineEnd + 2;
        let endNeeded := bodyStart + bulkLen + 2;
        if endNeeded > n {
            return { .Done = false, .Consumed = 0, .Reply = empty, .Err = "" };
        }
        let text := bytesToStr(data, bodyStart, bulkLen);
        let rep := reply(ReplyKind::Bulk, text, 0);
        return { .Done = true, .Consumed = (endNeeded - start), .Reply = rep, .Err = "" };
    }
    if prefix == 42 { // '*' array
        return { .Done = false, .Consumed = 0, .Reply = empty, .Err = "array replies not supported yet" };
    }

    return { .Done = false, .Consumed = 0, .Reply = empty, .Err = "invalid resp" };
}

fn concatBytes(a: []byte, b: []byte) -> []byte {
    let out: []byte = [];
    let i: i32 = 0;
    while i < len(&a) {
        append(&mut out, a[i]);
        i += 1;
    }
    let j: i32 = 0;
    while j < len(&b) {
        append(&mut out, b[j]);
        j += 1;
    }
    return out;
}

fn dropBytes(buf: []byte, n: i32) -> []byte {
    if n <= 0 {
        return buf;
    }
    let out: []byte = [];
    let i: i32 = n;
    let total := len(&buf);
    while i < total {
        append(&mut out, buf[i]);
        i += 1;
    }
    return out;
}

fn (c: &mut Client) readReply() -> str ! Reply {
    while true {
        let res := parseAt(c.buf, 0);
        if res.Err != "" {
            return res.Err!;
        }
        if res.Done {
            c.buf = dropBytes(c.buf, res.Consumed);
            return res.Reply;
        }

        let chunk := net::Read(c.conn, 4096) catch err {
            return err!;
        };
        if len(&chunk) == 0 {
            return "connection closed"!;
        }
        c.buf = concatBytes(c.buf, chunk);
    }
}

fn (c: &mut Client) commandArgs(args: []str) -> str ! Reply {
    let cmd := buildCommand(args);
    let written := net::WriteStr(c.conn, cmd) catch err {
        return err!;
    };
    let rep := c.readReply() catch err {
        return err!;
    };
    if rep.Kind == ReplyKind::Error {
        return rep.Text!;
    }
    return rep;
}

fn (c: &mut Client) Command(args: ...str) -> str ! Reply {
    return c.commandArgs(args) catch err {
        return err!;
    };
}

fn (c: &mut Client) CommandStr(args: ...str) -> str ! str {
    let rep := c.commandArgs(args) catch err {
        return err!;
    };
    if rep.Kind == ReplyKind::Simple || rep.Kind == ReplyKind::Bulk {
        return rep.Text;
    }
    if rep.Kind == ReplyKind::Integer {
        return "" + rep.Number;
    }
    if rep.Kind == ReplyKind::Nil {
        return "";
    }
    return "unexpected reply type"!;
}

fn (c: &mut Client) CommandInt(args: ...str) -> str ! i64 {
    let rep := c.commandArgs(args) catch err {
        return err!;
    };
    if rep.Kind == ReplyKind::Integer {
        return rep.Number;
    }
    return "unexpected reply type"!;
}

fn (c: &mut Client) Ping() -> str ! str {
    return c.CommandStr("PING") catch err {
        return err!;
    };
}

fn (c: &mut Client) Get(key: str) -> str ! str? {
    let rep := c.Command("GET", key) catch err {
        return err!;
    };
    if rep.Kind == ReplyKind::Nil {
        return none;
    }
    if rep.Kind == ReplyKind::Bulk || rep.Kind == ReplyKind::Simple {
        return rep.Text;
    }
    return "unexpected reply type"!;
}

fn (c: &mut Client) Set(key: str, value: str) -> str ! bool {
    let rep := c.Command("SET", key, value) catch err {
        return err!;
    };
    if rep.Kind == ReplyKind::Simple && rep.Text == "OK" {
        return true;
    }
    return false;
}

fn (c: &mut Client) Del(key: str) -> str ! i64 {
    return c.CommandInt("DEL", key) catch err {
        return err!;
    };
}

