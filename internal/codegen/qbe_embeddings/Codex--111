func (d *DataLayout) SizeOf(t types.SemType) int {
	if t == nil {
		return 0
	}
	t = types.UnwrapType(t)

	switch tt := t.(type) {
	case *types.PrimitiveType:
		switch tt.GetName() {
		case types.TYPE_STRING:
			return d.PointerSize
		case types.TYPE_VOID, types.TYPE_NONE:
