    if data[i] == 45 { // '-'
        sign = -1;
        i += 1;
    }
    let n: i64 = 0;
    while i < end {
        n = n * 10 + ((data[i] as i64) - 48);
        i += 1;
    }
    return n * sign;
}

fn parseInt32(data: []byte, start: i32, end: i32) -> i32 {
    let i: i32 = start;
