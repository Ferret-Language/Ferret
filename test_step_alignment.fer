import "std/io";

fn main() {
    let a := 10;
    let b := 11;

    // Should warn: always false (10 not in [3,5,7,9,11,13])
    if a in 3..15:2 {
        io::Println("a=10 is in sequence");
    }

    // Should warn: always true (11 is in [3,5,7,9,11,13])
    if b in 3..15:2 {
        io::Println("b=11 is in sequence");
    }

    // Direct test
    if 11 in 3..15:2 {
        io::Println("11 is in 3..15:2");
    }
}
