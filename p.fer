import "std/io";

fn main() {
    io::Println("=== Char Type Tests ===");
    
    // Test char literals
    let ch1 := '💡';
    let ch2 := 'Z';
    let ch3 := '5';
    
    io::Println(ch1);
    io::Println(ch2);
    io::Println(ch3);
    
    // Test numeric to char conversion
    let from_num := 66 as char; // 'B'
    io::Println(from_num);
    
    // Test char to numeric conversion
    let to_num := 'C' as i32;
    io::Println(to_num); // Should print 67
    
    io::Println("=== Byte Type Tests ===");
    
    // Test byte literal with b'' prefix
    let b1 := b'X';
    let b2 := b'Y';
    io::Println(b1);
    io::Println(b2);
    
    // Test byte to char conversion
    let ch_from_byte := b'M' as char;
    io::Println(ch_from_byte);
    
    // Test char to byte conversion (truncate)
    let byte_from_char := 'N' as byte;
    io::Println(byte_from_char);
    
    io::Println("=== Conversion Tests ===");
    
    // Multiple conversions
    let val1 := 72 as char as i32;
    io::Println(val1); // Should be 72
    
    let val2 := b'P' as char as byte as i32;
    io::Println(val2); // Should be 80 (ASCII 'P')

    io::Println("=== String Iteration Tests ===");

    // Test mutable ref with i32 array first
    let nums: []i32 = [1, 2, 3];
    io::Println("Before nums:", nums[0], nums[1], nums[2]);
    for i, &mut v in nums {
        io::Println("Modifying index", i, "old value", *v);
        *v = *v + 10;
        io::Println("New value", *v);
    }
    io::Println("After nums:", nums[0], nums[1], nums[2]);

    // Test string to char array with copy
    for i, v in ("hello" as []char) {
        io::Println(i, v);
    }

    // Test with emoji
    for i, v in ("💡🚀" as []char) {
        io::Println(i, v);
    }

    // Test immutable ref
    for i, &v in ("world" as []char) {
        io::Println(i, *v);
    }

    // Test byte array
    for i, v in ("test" as []byte) {
        io::Println(i, v);
    }

    // Test mutable ref - should modify original array
    let chars := "ABC" as []char;
    io::Println("Before:", chars[0], chars[1], chars[2]);
    for i, &mut v in chars {
        *v = ((*v) as i32 + 1) as char; // Increment each character (A->B, B->C, C->D)
    }
    io::Println("After:", chars[0], chars[1], chars[2]);
}