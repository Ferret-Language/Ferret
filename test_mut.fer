import "std/io";

type Point struct { .X: i32, .Y: i32 };

fn (p: &mut Point) move(dx: i32, dy: i32) {
    p.X += dx;
    p.Y += dy;
}

fn main() {
    let point: Point = { .X = 0, .Y = 0 };

    let r := &point;          // immutable borrow starts
    io::Println(r.X);         // use it (so it can't be "released" early)

    point.move(5, 10);        // ERROR: needs &mut point, but r is still alive

    io::Println(r.Y);         // r still used later => definitely alive
}