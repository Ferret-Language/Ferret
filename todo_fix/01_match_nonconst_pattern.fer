import "std/io";
// TODO: should be supported (match on non-const pattern expression)
// Current error: MIR lowering unsupported: match pattern
fn foo() -> i32 {
    return 2;
}

fn main() {
    let v: i32 = 2;
    match v {
        foo() => { 
            io::Println("foo");
        }
        _ => {
            io::Println("none");
        }
    }
}
