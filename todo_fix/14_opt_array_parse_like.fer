fn parseInt32(data: []byte, start: i32, end: i32) -> i32 {
    let i: i32 = start;
    if i >= end {
        return 0;
    }
    let sign: i32 = 1;
    if data[i] == 45 { // '-'
        sign = -1;
        i += 1;
    }
    let n: i32 = 0;
    while i < end {
        n = n * 10 + ((data[i] as i32) - 48);
        i += 1;
    }
    return n * sign;
}

fn parseLike(data: []byte) -> []?str {
    let out: []?str = [] as []?str;
    let idx: i32 = 0;
    let n := len(&data);
    if n < 3 {
        return out;
    }
    if data[idx] != 42 { // '*'
        return out;
    }
    idx += 1;

    // assume single-digit count
    let count := parseInt32(data, idx, idx + 1);
    idx = idx + 3; // "<d>\r\n"

    let i: i32 = 0;
    while i < count {
        if idx >= n {
            return out;
        }
        if data[idx] != 36 { // '$'
            return out;
        }
        idx += 1;

        let len := parseInt32(data, idx, idx + 1);
        idx = idx + 3; // "<d>\r\n" or "-1\r\n"
        if len < 0 {
            append(&mut out, none);
            i += 1;
            continue;
        }

        let s := "";
        let j: i32 = 0;
        while j < len {
            s = s + data[idx + j];
            j += 1;
        }
        idx = idx + len + 2; // payload + "\r\n"
        append(&mut out, s);
        i += 1;
    }

    return out;
}

fn main() {
    let data := "*2\r\n$3\r\nfoo\r\n$-1\r\n" as []byte;
    let out := parseLike(data);
    let i: i32 = 0;
    while i < len(&out) {
        let v := out[i];
        if v == none {
            print("nil");
        } else {
            print(v);
        }
        i += 1;
    }
}
