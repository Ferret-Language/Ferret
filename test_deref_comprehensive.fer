import "std/io" as io;

fn main() -> i32 {
    io::Println("=== Comprehensive Dereference Tests ===");
    
    // Test 1: Basic dereference
    io::Println("1. Basic dereference:");
    let x := 42;
    let r: &i32 = &x;
    io::Println(*r);
    
    // Test 2: Mutable reference with assignment
    io::Println("2. Mutable reference assignment:");
    let y := 10;
    let r_mut: &mut i32 = &mut y;
    *r_mut = 20;
    io::Println(y);
    io::Println(*r_mut);
    
    // Test 3: Dereference in expression
    io::Println("3. Dereference in expression:");
    let a := 5;
    let b := 3;
    let ra: &i32 = &a;
    let rb: &i32 = &b;
    let sum := *ra + *rb;
    io::Println(sum);
    
    // Test 4: Multiple dereferences
    io::Println("4. Multiple dereferences:");
    let val := 100;
    let ref1: &i32 = &val;
    io::Println(*ref1);
    let intermediate := *ref1;
    io::Println(intermediate);
    
    // Test 5: String reference
    io::Println("5. String reference:");
    let msg := "Hello, Ferret!";
    let str_ref: &str = &msg;
    io::Println(*str_ref);
    
    io::Println("=== All tests passed! ===");
    return 0;
}
