module enum
type Color enum { Red, Green, Blue }

globals:
    let mut RuntimeColor: Color = 0
    const DefaultColor: Color = 1

fn main(flag bool) i32 {
locals:
    flag: bool
    value: Color [mut]
    _t2: bool [temp]
    _t3: i32 [temp]
entry:
    value = 2
    branch flag -> bb1, bb2
bb1:
    store deref addr_of value = RuntimeColor
    jump bb3
bb2:
    jump bb3
bb3:
    _t2 = eq value 1
    branch _t2 -> bb4, bb5
bb4:
    return 1
bb5:
    jump bb6
bb6:
    _t3 = value as i32
    return _t3
}
